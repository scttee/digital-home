---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = 'Digital Home', 
  description = 'A personal space on the web, owned and curated by me.'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body>
  <header class="site-header">
    <div class="container-narrow">
      <nav class="nav">
        <a href="/" class="logo">Digital Home</a>
        <div class="nav-links">
          <a href="/thoughts">Thoughts</a>
          <a href="/adventures">Adventures</a>
          <a href="/archive">Archive</a>
          <a href="/stories">Stories</a>
          <a href="/connect">Connect</a>
        </div>
      </nav>
    </div>
  </header>

  <main class="site-main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container-narrow">
      <p class="footer-text">
        Built with intention. Owned completely. 
        <span class="footer-year">{new Date().getFullYear()}</span>
      </p>
    </div>
  </footer>
</body>
</html>

<style>
  .site-header {
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--color-dune);
    position: sticky;
    top: 0;
    background: rgba(249, 247, 244, 0.95);
    backdrop-filter: blur(10px);
    z-index: 100;
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-deep);
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: var(--space-md);
  }

  .nav-links a {
    font-family: var(--font-display);
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-stone);
    position: relative;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--color-ocean);
    transition: width 0.3s var(--ease-editorial);
  }

  .nav-links a:hover {
    color: var(--color-deep);
  }

  .nav-links a:hover::after {
    width: 100%;
  }

  .site-main {
    min-height: calc(100vh - 300px);
    padding: var(--space-lg) 0;
  }

  .site-footer {
    border-top: 1px solid var(--color-dune);
    padding: var(--space-md) 0;
    margin-top: var(--space-xl);
  }

  .footer-text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-align: center;
    color: var(--color-stone);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .footer-year {
    color: var(--color-ocean);
  }

  @media (max-width: 640px) {
    .nav {
      flex-direction: column;
      gap: var(--space-sm);
    }

    .nav-links {
      gap: var(--space-sm);
    }

    .site-header {
      padding: var(--space-sm) 0;
    }
  }
</style>
