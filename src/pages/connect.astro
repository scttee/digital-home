---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProfile } from '../lib/db-static';

const profile = getProfile();
---

<BaseLayout title="Connect — Digital Home">
  <div class="block-page">
    <div class="block-grid">
      <!-- Header block -->
      <div class="block block-header">
        <span class="block-label">Connect</span>
        <h1 class="block-title">Get in Touch</h1>
        <p class="block-subtitle">This space is open for genuine connection. If something here resonates, reach out.</p>
      </div>

      <!-- Email block - main CTA -->
      <a href="mailto:scottshirbin@gmail.com" class="block email-block">
        <span class="email-label">Email</span>
        <span class="email-address">scottshirbin@gmail.com</span>
        <span class="email-arrow">&rarr;</span>
      </a>

      <!-- About block -->
      <div class="block about-block">
        {profile?.avatar_url && (
          <div class="profile-image">
            <img src={profile.avatar_url} alt={profile?.username || 'Profile'} />
          </div>
        )}
        <div class="profile-info">
          <p class="bio">{profile?.bio || 'A personal digital space.'}</p>
          <p class="philosophy">I believe in slow connection, intentional presence, and building things that last.</p>
        </div>
      </div>

      <!-- Interest blocks -->
      <div class="block interest-block" style="animation-delay: 0.1s">
        <h3 class="interest-title">Making</h3>
        <p class="interest-text">Building things with intention. Design, code, writing. Craft over speed.</p>
      </div>

      <div class="block interest-block" style="animation-delay: 0.16s">
        <h3 class="interest-title">Nature</h3>
        <p class="interest-text">Coastal walks, changing light, the ocean's rhythm. Being outside.</p>
      </div>

      <div class="block interest-block" style="animation-delay: 0.22s">
        <h3 class="interest-title">Ideas</h3>
        <p class="interest-text">Systems thinking, regenerative approaches, digital sovereignty.</p>
      </div>

      <div class="block interest-block" style="animation-delay: 0.28s">
        <h3 class="interest-title">Culture</h3>
        <p class="interest-text">Editorial design, zines, independent publishing, analog aesthetics.</p>
      </div>

      <!-- Links block -->
      <div class="block links-block">
        <span class="links-label">Explore</span>
        <div class="links-grid">
          <a href="/thoughts" class="site-link">Thoughts</a>
          <a href="/adventures" class="site-link">Adventures</a>
          <a href="/stories" class="site-link">Stories</a>
          <a href="/archive" class="site-link">Archive</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .block-page {
    padding: 0 1rem 4rem;
    max-width: 100%;
  }

  .block-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
  }

  .block {
    background: var(--color-offwhite);
    padding: 2rem;
    animation: blockIn 0.5s var(--ease-smooth) backwards;
    transition: background 0.2s var(--ease-smooth);
  }

  .block:hover {
    background: var(--color-sand);
  }

  .block-header {
    grid-column: 1 / -1;
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .block-header:hover {
    background: var(--color-offwhite);
  }

  .block-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-hot);
  }

  .block-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .block-subtitle {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-stone);
    max-width: 36rem;
    margin: 0;
  }

  /* Email block */
  .email-block {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 2.5rem 2rem;
    text-decoration: none;
    color: var(--color-deep);
    cursor: pointer;
  }

  .email-block:hover {
    background: var(--color-sand);
    color: var(--color-deep);
  }

  .email-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-hot);
    flex-shrink: 0;
  }

  .email-address {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    flex: 1;
  }

  .email-arrow {
    font-size: 1.5rem;
    color: var(--color-stone);
    transition: all 0.3s var(--ease-smooth);
    flex-shrink: 0;
  }

  .email-block:hover .email-arrow {
    color: var(--color-hot);
    transform: translateX(6px);
  }

  /* About block */
  .about-block {
    grid-column: 1 / -1;
    display: flex;
    gap: 2rem;
    align-items: start;
    padding: 2.5rem 2rem;
  }

  .about-block:hover {
    background: var(--color-offwhite);
  }

  .profile-image {
    flex-shrink: 0;
    width: 120px;
    height: 120px;
    overflow: hidden;
  }

  .profile-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile-info {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .bio {
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-style: italic;
    line-height: 1.6;
    color: var(--color-stone);
    margin: 0;
  }

  .philosophy {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-deep);
    margin: 0;
  }

  /* Interest blocks */
  .interest-block {
    min-height: 180px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
  }

  .interest-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-hot);
  }

  .interest-text {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-stone);
    margin: 0;
  }

  /* Links block */
  .links-block {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem;
  }

  .links-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-stone);
  }

  .links-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .site-link {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--color-border);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-deep);
    text-decoration: none;
    transition: all 0.2s var(--ease-smooth);
  }

  .site-link:hover {
    background: linear-gradient(135deg, var(--color-hot), var(--color-electric));
    color: white;
    border-color: transparent;
  }

  @keyframes blockIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .block-grid {
      grid-template-columns: 1fr;
    }

    .block-header {
      padding: 2rem 1.5rem;
    }

    .about-block {
      flex-direction: column;
    }

    .profile-image {
      width: 100%;
      height: 200px;
    }

    .email-block {
      flex-wrap: wrap;
    }
  }
</style>
