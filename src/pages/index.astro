---
import '../styles/global.css';
import { getThoughts, getProfile } from '../lib/db-static';
import { getTrips } from '../lib/photography-static';
import { getSubstackPosts } from '../lib/substack';

const profile = getProfile();
const thoughts = getThoughts(10);
const trips = getTrips();
const substackPosts = await getSubstackPosts();

function formatDate(dateString: string): string {
  return new Date(dateString).toLocaleDateString('en-AU', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  });
}

function parseTags(tags: string | null): string[] {
  if (!tags) return [];
  try { return JSON.parse(tags); } catch { return []; }
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Scott Shirbin — a personal space on the web.">
  <title>Scott Shirbin — Digital Home</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body class="horizontal-page">

  <!-- Floating nav — dots only -->
  <nav class="floating-nav" id="floatingNav">
    <a href="/" class="nav-logo">SS</a>
    <div class="nav-dots" id="navDots">
      <button class="nav-dot active" data-index="0" aria-label="Intro"><span class="dot-label">00</span></button>
      <button class="nav-dot" data-index="1" aria-label="Thoughts"><span class="dot-label">01</span></button>
      <button class="nav-dot" data-index="2" aria-label="Adventures"><span class="dot-label">02</span></button>
      <button class="nav-dot" data-index="3" aria-label="Stories"><span class="dot-label">03</span></button>
      <button class="nav-dot" data-index="4" aria-label="About"><span class="dot-label">04</span></button>
    </div>
  </nav>

  <!-- Horizontal scroll container -->
  <div class="scroller" id="scroller">

    <!-- Panel 00: Opener — scattered letters -->
    <section class="panel opener-panel" data-section="opener">
      <div class="opener-name" id="openerName">
        <div class="opener-line">
          <span class="scatter-letter" data-sx="-30" data-sy="-25" data-sr="-25" data-blur="8">S</span>
          <span class="scatter-letter" data-sx="22" data-sy="-38" data-sr="18">C</span>
          <span class="scatter-letter" data-sx="-18" data-sy="32" data-sr="-42" data-blur="12">O</span>
          <span class="scatter-letter" data-sx="38" data-sy="18" data-sr="30">T</span>
          <span class="scatter-letter" data-sx="-42" data-sy="-12" data-sr="-15" data-blur="6">T</span>
        </div>
        <div class="opener-line">
          <span class="scatter-letter" data-sx="28" data-sy="-22" data-sr="22">S</span>
          <span class="scatter-letter" data-sx="-32" data-sy="38" data-sr="-35" data-blur="10">H</span>
          <span class="scatter-letter" data-sx="42" data-sy="-32" data-sr="42">I</span>
          <span class="scatter-letter" data-sx="-22" data-sy="15" data-sr="-28" data-blur="14">R</span>
          <span class="scatter-letter" data-sx="32" data-sy="28" data-sr="16">B</span>
          <span class="scatter-letter" data-sx="-26" data-sy="-35" data-sr="-32" data-blur="8">I</span>
          <span class="scatter-letter" data-sx="18" data-sy="-42" data-sr="28">N</span>
        </div>
      </div>
      <span class="opener-hint">Scroll to explore</span>
    </section>

    <!-- Panel 01: Thoughts -->
    <section class="panel" data-section="thoughts">
      <div class="panel-watermark">01</div>
      <div class="panel-inner">
        <div class="panel-header">
          <span class="panel-number">01</span>
          <h2 class="panel-title gradient-text">Thoughts</h2>
        </div>
        <div class="cards-track">
          {thoughts.map((thought) => (
            <a href="/thoughts" class="card thought-card">
              <p class="card-body">{thought.content}</p>
              <div class="card-meta">
                {parseTags(thought.tags).length > 0 && (
                  <div class="card-tags">
                    {parseTags(thought.tags).map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                )}
                <time class="card-date">{formatDate(thought.created_at)}</time>
              </div>
            </a>
          ))}
          <a href="/thoughts" class="card view-all-card">
            <span class="view-all-arrow">&rarr;</span>
            <span class="view-all-text">All thoughts</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Panel 02: Adventures -->
    <section class="panel" data-section="adventures">
      <div class="panel-watermark">02</div>
      <div class="panel-inner">
        <div class="panel-header">
          <span class="panel-number">02</span>
          <h2 class="panel-title gradient-text">Adventures</h2>
        </div>
        <div class="cards-track">
          {trips.length > 0 ? (
            trips.map((trip) => (
              <a href={`/adventures/${trip.slug}`} class="card adventure-card">
                {trip.cover_image_url && (
                  <div class="card-image">
                    <img src={trip.cover_image_url} alt={trip.title} loading="lazy" />
                  </div>
                )}
                <div class="card-info">
                  <span class="card-location">{trip.location}</span>
                  <h3 class="card-title">{trip.title}</h3>
                  {trip.description && <p class="card-body">{trip.description}</p>}
                  {trip.start_date && (
                    <time class="card-date">{formatDate(trip.start_date)}</time>
                  )}
                </div>
              </a>
            ))
          ) : (
            <div class="empty-card">
              <p>No adventures yet.</p>
            </div>
          )}
          <a href="/adventures" class="card view-all-card">
            <span class="view-all-arrow">&rarr;</span>
            <span class="view-all-text">All adventures</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Panel 03: Stories -->
    <section class="panel" data-section="stories">
      <div class="panel-watermark">03</div>
      <div class="panel-inner">
        <div class="panel-header">
          <span class="panel-number">03</span>
          <h2 class="panel-title gradient-text">Stories</h2>
        </div>
        <div class="cards-track">
          {substackPosts.length > 0 ? (
            substackPosts.slice(0, 6).map((post) => (
              <a href={post.link} target="_blank" rel="noopener noreferrer" class="card story-card">
                {post.image && (
                  <div class="card-image">
                    <img src={post.image} alt={post.title} loading="lazy" />
                  </div>
                )}
                <div class="card-info">
                  <h3 class="card-title">{post.title}</h3>
                  {post.excerpt && (
                    <p class="card-body">{post.excerpt}</p>
                  )}
                  {post.date && (
                    <time class="card-date">{formatDate(post.date)}</time>
                  )}
                </div>
              </a>
            ))
          ) : (
            <div class="empty-card">
              <p>Stories live on <a href="https://substack.com/@scttee" target="_blank" rel="noopener noreferrer" style="color: var(--color-hot); text-decoration: none;">Substack</a></p>
            </div>
          )}
          <a href="/stories" class="card view-all-card">
            <span class="view-all-arrow">&rarr;</span>
            <span class="view-all-text">All stories</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Panel 04: About Me -->
    <section class="panel" data-section="about">
      <div class="panel-watermark">04</div>
      <div class="panel-inner about-panel">
        <div class="panel-header">
          <span class="panel-number">04</span>
          <h2 class="panel-title">About</h2>
        </div>
        <div class="about-content">
          <div class="about-card">
            <h3 class="about-name">I'm <span class="gradient-text">Scott Shirbin</span></h3>
            <p class="about-bio">I make things, go outside, and take photos of it all. This is my corner of the internet — no algorithms, no feeds, no metrics.</p>
            <div class="about-details">
              <p>Photographer. Builder. Coastal wanderer. I believe in slow connection, intentional making, and owning your digital space.</p>
            </div>
            <div class="about-links">
              <a href="mailto:scottshirbin@gmail.com" class="about-link about-link-primary">Say hello &rarr;</a>
              <a href="/adventures" class="about-link">Adventures</a>
              <a href="/thoughts" class="about-link">Thoughts</a>
              <a href="/stories" class="about-link">Stories</a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </div>

  <script>
    const scroller = document.getElementById('scroller');
    const dots = document.querySelectorAll('.nav-dot');
    const panels = document.querySelectorAll('.panel');
    const letters = document.querySelectorAll('.scatter-letter');
    const openerHint = document.querySelector('.opener-hint');

    // Scatter letter animation driven by scroll
    function updateLetters() {
      if (!scroller) return;
      const panelWidth = scroller.offsetWidth;
      const rawProgress = Math.min(Math.max(scroller.scrollLeft / panelWidth, 0), 1);

      // Letters fully assemble at 25% scroll — complete well before snap
      const progress = Math.min(rawProgress * 4, 1);

      // Ease the progress for smoother feel
      const eased = 1 - Math.pow(1 - progress, 3);

      letters.forEach((letter) => {
        const el = letter as HTMLElement;
        const sx = parseFloat(el.dataset.sx || '0');
        const sy = parseFloat(el.dataset.sy || '0');
        const sr = parseFloat(el.dataset.sr || '0');
        const blurMax = parseFloat(el.dataset.blur || '0');

        const x = sx * (1 - eased);
        const y = sy * (1 - eased);
        const r = sr * (1 - eased);
        const scale = 0.6 + (0.4 * eased);
        const opacity = 0.15 + (0.85 * eased);
        const blur = blurMax * (1 - eased);

        el.style.transform = `translate(${x}vw, ${y}vh) rotate(${r}deg) scale(${scale})`;
        el.style.opacity = String(opacity);
        el.style.filter = blur > 0.1 ? `blur(${blur}px)` : 'none';
      });

      // Fade out hint
      if (openerHint) {
        (openerHint as HTMLElement).style.opacity = String(Math.max(1 - progress * 4, 0));
      }
    }

    // Convert vertical scroll to horizontal (desktop)
    scroller?.addEventListener('wheel', (e) => {
      if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
        e.preventDefault();
        scroller.scrollLeft += e.deltaY;
      }
    }, { passive: false });

    // Update active dot + letters on scroll
    let ticking = false;
    scroller?.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          const scrollLeft = scroller!.scrollLeft;
          const panelWidth = scroller!.offsetWidth;
          const activeIndex = Math.round(scrollLeft / panelWidth);

          dots.forEach((dot, i) => {
            dot.classList.toggle('active', i === activeIndex);
          });

          updateLetters();
          ticking = false;
        });
        ticking = true;
      }
    });

    // Dot navigation
    dots.forEach(dot => {
      dot.addEventListener('click', () => {
        const index = parseInt(dot.getAttribute('data-index') || '0');
        const panelWidth = scroller?.offsetWidth || 0;
        scroller?.scrollTo({
          left: index * panelWidth,
          behavior: 'smooth'
        });
      });
    });

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        scroller?.scrollBy({ left: scroller.offsetWidth, behavior: 'smooth' });
      } else if (e.key === 'ArrowLeft') {
        scroller?.scrollBy({ left: -scroller.offsetWidth, behavior: 'smooth' });
      }
    });

    // Initialize letter scatter
    updateLetters();
  </script>
</body>
</html>

<style>
  .horizontal-page {
    margin: 0;
    padding: 0;
    overflow: hidden;
    height: 100vh;
    background: var(--color-offwhite);
  }

  /* Floating nav — minimal dots */
  .floating-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 2rem;
    z-index: 100;
  }

  .nav-logo {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--color-deep);
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-logo:hover {
    color: var(--color-hot);
  }

  .nav-dots {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav-dot {
    position: relative;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1.5px solid var(--color-stone);
    background: transparent;
    padding: 0;
    cursor: pointer;
    transition: all 0.3s var(--ease-smooth);
  }

  .nav-dot.active {
    background: var(--color-hot);
    border-color: var(--color-hot);
    transform: scale(1.4);
  }

  .dot-label {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    color: var(--color-stone);
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.2s;
    pointer-events: none;
    letter-spacing: 0.1em;
  }

  .nav-dot:hover .dot-label {
    opacity: 1;
  }

  /* Horizontal scroller */
  .scroller {
    display: flex;
    height: 100vh;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .scroller::-webkit-scrollbar {
    display: none;
  }

  /* === OPENER PANEL === */
  .opener-panel {
    flex: 0 0 100vw;
    width: 100vw;
    height: 100vh;
    scroll-snap-align: start;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .opener-name {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    z-index: 2;
  }

  .opener-line {
    display: flex;
    justify-content: center;
    line-height: 1;
  }

  .scatter-letter {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 11vw, 9rem);
    font-weight: 700;
    letter-spacing: -0.06em;
    color: var(--color-deep);
    display: inline-block;
    will-change: transform, opacity;
    transition: none;
  }

  .opener-hint {
    position: absolute;
    bottom: 3rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-stone);
    z-index: 2;
    animation: hintBreathe 3s ease-in-out infinite;
  }

  @keyframes hintBreathe {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 1; }
  }

  /* === CONTENT PANELS === */
  .panel {
    flex: 0 0 100vw;
    width: 100vw;
    height: 100vh;
    scroll-snap-align: start;
    display: flex;
    align-items: center;
    padding: 5rem 3rem 3rem;
    position: relative;
    overflow: hidden;
  }

  /* Giant watermark number */
  .panel-watermark {
    position: absolute;
    top: 50%;
    right: -0.05em;
    transform: translateY(-50%);
    font-family: var(--font-display);
    font-size: clamp(12rem, 30vw, 22rem);
    font-weight: 700;
    letter-spacing: -0.06em;
    color: var(--color-border);
    opacity: 0.5;
    pointer-events: none;
    line-height: 1;
    z-index: 0;
    user-select: none;
  }

  .panel-inner {
    width: 100%;
    max-width: 80rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    height: 100%;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  .panel-header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .panel-number {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    color: var(--color-hot);
    text-transform: uppercase;
  }

  .panel-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    color: var(--color-deep);
    line-height: 0.9;
  }

  /* Gradient text — animated */
  .gradient-text {
    background: linear-gradient(135deg, var(--color-hot), var(--color-electric), var(--color-lime), var(--color-sunset), var(--color-hot));
    background-size: 300% 300%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradientShift 6s ease infinite;
  }

  @keyframes gradientShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  /* Cards track */
  .cards-track {
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 1rem;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
    -webkit-overflow-scrolling: touch;
  }

  .cards-track::-webkit-scrollbar { height: 3px; }
  .cards-track::-webkit-scrollbar-track { background: transparent; }
  .cards-track::-webkit-scrollbar-thumb { background: var(--color-border); border-radius: 2px; }

  /* Base card — clean, no underglow */
  .card {
    flex: 0 0 340px;
    min-height: 220px;
    background: var(--color-offwhite);
    border: 1px solid var(--color-border);
    padding: 1.75rem;
    text-decoration: none;
    color: var(--color-deep);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.25s var(--ease-smooth);
    cursor: pointer;
  }

  .card:hover {
    border-color: var(--color-hot);
    transform: translateY(-2px);
    color: var(--color-deep);
  }

  .thought-card { flex: 0 0 360px; }

  .card-body {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.65;
    margin: 0;
    color: var(--color-deep);
    flex: 1;
  }

  .card-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .card-tags { display: flex; flex-wrap: wrap; gap: 0.375rem; }

  .tag {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    background: var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    color: var(--color-stone);
  }

  .card-date {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    color: var(--color-stone);
  }

  /* Adventure cards */
  .adventure-card {
    flex: 0 0 380px;
    padding: 0;
    overflow: hidden;
    min-height: 320px;
  }

  .card-image { width: 100%; height: 200px; overflow: hidden; }
  .card-image img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s var(--ease-smooth); }
  .card:hover .card-image img { transform: scale(1.04); }

  .card-info {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    flex: 1;
  }

  .card-location {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-hot);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-deep);
    margin: 0;
    line-height: 1.2;
  }

  .card-info .card-body { font-size: 0.9375rem; color: var(--color-stone); line-height: 1.5; }

  .story-card { flex: 0 0 340px; padding: 0; overflow: hidden; }

  /* View all card */
  .view-all-card {
    flex: 0 0 200px;
    min-height: 220px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    border-style: dashed;
    color: var(--color-stone);
  }

  .view-all-card:hover {
    color: var(--color-hot);
    border-color: var(--color-hot);
    border-style: solid;
  }

  .view-all-arrow {
    font-size: 2rem;
    transition: transform 0.3s var(--ease-smooth);
  }

  .view-all-card:hover .view-all-arrow { transform: translateX(6px); }

  .view-all-text {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .empty-card {
    flex: 0 0 340px;
    min-height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px dashed var(--color-border);
    padding: 2rem;
  }

  .empty-card p {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-stone);
    text-align: center;
    margin: 0;
  }

  /* === ABOUT PANEL === */
  .about-panel {
    justify-content: center;
    align-items: flex-start;
  }

  .about-content { max-width: 40rem; }

  .about-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .about-name {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--color-deep);
    margin: 0;
    line-height: 1.1;
  }

  .about-bio {
    font-family: var(--font-body);
    font-size: 1.375rem;
    line-height: 1.5;
    color: var(--color-deep);
    margin: 0;
  }

  .about-details p {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-stone);
    margin: 0;
  }

  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .about-link {
    display: inline-flex;
    align-items: center;
    padding: 0.625rem 1.25rem;
    border: 1px solid var(--color-border);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-deep);
    text-decoration: none;
    transition: all 0.2s var(--ease-smooth);
  }

  .about-link:hover {
    border-color: var(--color-hot);
    color: var(--color-hot);
  }

  .about-link-primary {
    background: var(--color-hot);
    border-color: var(--color-hot);
    color: white;
