---
import '../styles/global.css';
import { getThoughts, getProfile } from '../lib/db-static';
import { getTrips } from '../lib/photography-static';
import { getStories } from '../lib/db-static';

const profile = getProfile();
const thoughts = getThoughts(10);
const trips = getTrips();
const stories = getStories();

function formatDate(dateString: string): string {
  return new Date(dateString).toLocaleDateString('en-AU', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  });
}

function parseTags(tags: string | null): string[] {
  if (!tags) return [];
  try { return JSON.parse(tags); } catch { return []; }
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="A personal space on the web, owned and curated by me.">
  <title>Digital Home</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body class="horizontal-page">

  <!-- Floating nav -->
  <nav class="floating-nav">
    <a href="/" class="nav-logo">Digital Home</a>
    <div class="nav-dots" id="navDots">
      <button class="nav-dot active" data-index="0" aria-label="Thoughts"><span class="dot-label">Thoughts</span></button>
      <button class="nav-dot" data-index="1" aria-label="Adventures"><span class="dot-label">Adventures</span></button>
      <button class="nav-dot" data-index="2" aria-label="Stories"><span class="dot-label">Stories</span></button>
      <button class="nav-dot" data-index="3" aria-label="About"><span class="dot-label">About</span></button>
    </div>
  </nav>

  <!-- Horizontal scroll container -->
  <div class="scroller" id="scroller">

    <!-- Panel 1: Thoughts -->
    <section class="panel" data-section="thoughts">
      <div class="panel-inner">
        <div class="panel-header">
          <span class="panel-number">01</span>
          <h2 class="panel-title">Thoughts</h2>
          <p class="panel-subtitle">Recent reflections</p>
        </div>
        <div class="cards-track">
          {thoughts.map((thought) => (
            <a href="/thoughts" class="card thought-card">
              <p class="card-body">{thought.content}</p>
              <div class="card-meta">
                {parseTags(thought.tags).length > 0 && (
                  <div class="card-tags">
                    {parseTags(thought.tags).map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                )}
                <time class="card-date">{formatDate(thought.created_at)}</time>
              </div>
            </a>
          ))}
          <a href="/thoughts" class="card view-all-card">
            <span class="view-all-arrow">&rarr;</span>
            <span class="view-all-text">View all thoughts</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Panel 2: Adventures -->
    <section class="panel" data-section="adventures">
      <div class="panel-inner">
        <div class="panel-header">
          <span class="panel-number">02</span>
          <h2 class="panel-title">Adventures</h2>
          <p class="panel-subtitle">Places explored</p>
        </div>
        <div class="cards-track">
          {trips.length > 0 ? (
            trips.map((trip) => (
              <a href={`/adventures/${trip.slug}`} class="card adventure-card">
                {trip.cover_image_url && (
                  <div class="card-image">
                    <img src={trip.cover_image_url} alt={trip.title} loading="lazy" />
                  </div>
                )}
                <div class="card-info">
                  <span class="card-location">{trip.location}</span>
                  <h3 class="card-title">{trip.title}</h3>
                  {trip.description && <p class="card-body">{trip.description}</p>}
                  {trip.start_date && (
                    <time class="card-date">{formatDate(trip.start_date)}</time>
                  )}
                </div>
              </a>
            ))
          ) : (
            <div class="empty-card">
              <p>No adventures yet. Start exploring.</p>
            </div>
          )}
          <a href="/adventures" class="card view-all-card">
            <span class="view-all-arrow">&rarr;</span>
            <span class="view-all-text">All adventures</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Panel 3: Stories -->
    <section class="panel" data-section="stories">
      <div class="panel-inner">
        <div class="panel-header">
          <span class="panel-number">03</span>
          <h2 class="panel-title">Stories</h2>
          <p class="panel-subtitle">Long-form narratives</p>
        </div>
        <div class="cards-track">
          {stories.length > 0 ? (
            stories.map((story) => (
              <a href={`/stories/${story.slug}`} class="card story-card">
                {story.cover_image_url && (
                  <div class="card-image">
                    <img src={story.cover_image_url} alt={story.title} loading="lazy" />
                  </div>
                )}
                <div class="card-info">
                  <h3 class="card-title">{story.title}</h3>
                  {story.published_at && (
                    <time class="card-date">{formatDate(story.published_at)}</time>
                  )}
                </div>
              </a>
            ))
          ) : (
            <div class="empty-card">
              <p>Stories coming soon.</p>
            </div>
          )}
          <a href="/stories" class="card view-all-card">
            <span class="view-all-arrow">&rarr;</span>
            <span class="view-all-text">All stories</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Panel 4: About -->
    <section class="panel" data-section="about">
      <div class="panel-inner about-panel">
        <div class="panel-header">
          <span class="panel-number">04</span>
          <h2 class="panel-title">About</h2>
          <p class="panel-subtitle">This place</p>
        </div>
        <div class="about-content">
          <div class="about-card">
            <h3 class="about-name">{profile?.username || 'Welcome'}</h3>
            <p class="about-bio">{profile?.bio || 'A personal digital home'}</p>
            <div class="about-details">
              <p>A personal website built with intention. No algorithms, no feeds, no metrics. Just a quiet space to share thoughts, document adventures, and tell stories.</p>
            </div>
            <div class="about-links">
              <a href="/thoughts" class="about-link">Thoughts</a>
              <a href="/adventures" class="about-link">Adventures</a>
              <a href="/archive" class="about-link">Archive</a>
              <a href="/connect" class="about-link">Connect</a>
            </div>
            <div class="about-footer">
              <span class="about-year">Built with intention. Owned completely. {new Date().getFullYear()}</span>
            </div>
          </div>
        </div>
      </div>
    </section>

  </div>

  <!-- Scroll hint -->
  <div class="scroll-hint" id="scrollHint">
    <span class="scroll-hint-text">Scroll</span>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M5 12h14M12 5l7 7-7 7"/>
    </svg>
  </div>

  <script>
    const scroller = document.getElementById('scroller');
    const dots = document.querySelectorAll('.nav-dot');
    const panels = document.querySelectorAll('.panel');
    const scrollHint = document.getElementById('scrollHint');

    // Convert vertical scroll to horizontal (desktop)
    scroller?.addEventListener('wheel', (e) => {
      if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
        e.preventDefault();
        scroller.scrollLeft += e.deltaY;
      }
    }, { passive: false });

    // Touch swipe support for horizontal scrolling
    let touchStartX = 0;
    let touchStartY = 0;
    scroller?.addEventListener('touchstart', (e) => {
      touchStartX = e.touches[0].clientX;
      touchStartY = e.touches[0].clientY;
    }, { passive: true });

    scroller?.addEventListener('touchmove', (e) => {
      const dx = Math.abs(e.touches[0].clientX - touchStartX);
      const dy = Math.abs(e.touches[0].clientY - touchStartY);
      // If swiping more horizontally than vertically, let the scroller handle it
      if (dx > dy) {
        // Native horizontal scroll handles this via CSS scroll-snap
      }
    }, { passive: true });

    // Update active dot on scroll
    let scrollTimeout: ReturnType<typeof setTimeout>;
    scroller?.addEventListener('scroll', () => {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        const scrollLeft = scroller.scrollLeft;
        const panelWidth = scroller.offsetWidth;
        const activeIndex = Math.round(scrollLeft / panelWidth);

        dots.forEach((dot, i) => {
          dot.classList.toggle('active', i === activeIndex);
        });

        // Hide scroll hint after first scroll
        if (scrollLeft > 50 && scrollHint) {
          scrollHint.style.opacity = '0';
          scrollHint.style.pointerEvents = 'none';
        }
      }, 50);
    });

    // Dot navigation
    dots.forEach(dot => {
      dot.addEventListener('click', () => {
        const index = parseInt(dot.getAttribute('data-index') || '0');
        const panelWidth = scroller?.offsetWidth || 0;
        scroller?.scrollTo({
          left: index * panelWidth,
          behavior: 'smooth'
        });
      });
    });

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        scroller?.scrollBy({ left: scroller.offsetWidth, behavior: 'smooth' });
      } else if (e.key === 'ArrowLeft') {
        scroller?.scrollBy({ left: -scroller.offsetWidth, behavior: 'smooth' });
      }
    });
  </script>
</body>
</html>

<style>
  /* Page-level overrides */
  .horizontal-page {
    margin: 0;
    padding: 0;
    overflow: hidden;
    height: 100vh;
    background: var(--color-offwhite);
  }

  /* Floating navigation */
  .floating-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 2rem;
    z-index: 100;
    background: rgba(254, 252, 251, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-border);
  }

  @media (prefers-color-scheme: dark) {
    .floating-nav {
      background: rgba(17, 11, 15, 0.85);
    }
  }

  .nav-logo {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-deep);
    text-decoration: none;
    transition: opacity 0.2s var(--ease-smooth);
  }

  .nav-logo:hover {
    opacity: 0.5;
    color: var(--color-deep);
  }

  .nav-dots {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1.5px solid var(--color-stone);
    background: transparent;
    padding: 0;
    cursor: pointer;
    transition: all 0.3s var(--ease-smooth);
  }

  .nav-dot.active {
    background: var(--color-hot);
    border-color: var(--color-hot);
    transform: scale(1.3);
  }

  .dot-label {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--color-stone);
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.2s var(--ease-smooth);
    pointer-events: none;
  }

  .nav-dot:hover .dot-label {
    opacity: 1;
  }

  /* Horizontal scroller */
  .scroller {
    display: flex;
    height: 100vh;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .scroller::-webkit-scrollbar {
    display: none;
  }

  /* Panels */
  .panel {
    flex: 0 0 100vw;
    width: 100vw;
    height: 100vh;
    scroll-snap-align: start;
    display: flex;
    align-items: center;
    padding: 6rem 3rem 3rem;
  }

  .panel-inner {
    width: 100%;
    max-width: 80rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    height: 100%;
    justify-content: center;
  }

  .panel-header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .panel-number {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    color: var(--color-hot);
    text-transform: uppercase;
  }

  .panel-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--color-deep);
    line-height: 1;
  }

  .panel-subtitle {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-stone);
    margin: 0;
  }

  /* Cards track - horizontal scroll within panel */
  .cards-track {
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 1rem;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
    -webkit-overflow-scrolling: touch;
  }

  .cards-track::-webkit-scrollbar {
    height: 4px;
  }

  .cards-track::-webkit-scrollbar-track {
    background: transparent;
  }

  .cards-track::-webkit-scrollbar-thumb {
    background: var(--color-border);
    border-radius: 2px;
  }

  /* Base card */
  .card {
    flex: 0 0 340px;
    min-height: 220px;
    background: var(--color-offwhite);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.75rem;
    text-decoration: none;
    color: var(--color-deep);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.3s var(--ease-smooth);
    cursor: pointer;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(225, 29, 128, 0.1);
    border-color: var(--color-dune);
    color: var(--color-deep);
  }

  @media (prefers-color-scheme: dark) {
    .card:hover {
      box-shadow: 0 12px 32px rgba(244, 114, 182, 0.12);
    }
  }

  /* Thought cards */
  .thought-card {
    flex: 0 0 360px;
  }

  .card-body {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.65;
    margin: 0;
    color: var(--color-deep);
    flex: 1;
  }

  .card-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .tag {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    background: var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    color: var(--color-stone);
    border-radius: 4px;
  }

  .card-date {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    color: var(--color-stone);
  }

  /* Adventure cards */
  .adventure-card {
    flex: 0 0 380px;
    padding: 0;
    overflow: hidden;
    min-height: 320px;
  }

  .card-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-smooth);
  }

  .card:hover .card-image img {
    transform: scale(1.04);
  }

  .card-info {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    flex: 1;
  }

  .card-location {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-stone);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-deep);
    margin: 0;
    line-height: 1.2;
  }

  .card-info .card-body {
    font-size: 0.9375rem;
    color: var(--color-stone);
    line-height: 1.5;
  }

  /* Story cards */
  .story-card {
    flex: 0 0 340px;
    padding: 0;
    overflow: hidden;
  }

  /* View all card */
  .view-all-card {
    flex: 0 0 200px;
    min-height: 220px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    border-style: dashed;
    color: var(--color-stone);
  }

  .view-all-card:hover {
    color: var(--color-hot);
    border-style: solid;
    border-color: var(--color-dune);
  }

  .view-all-arrow {
    font-size: 2rem;
    transition: transform 0.3s var(--ease-smooth);
  }

  .view-all-card:hover .view-all-arrow {
    transform: translateX(6px);
  }

  .view-all-text {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  /* Empty state */
  .empty-card {
    flex: 0 0 340px;
    min-height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px dashed var(--color-border);
    border-radius: 12px;
    padding: 2rem;
  }

  .empty-card p {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-stone);
    text-align: center;
    margin: 0;
  }

  /* About panel */
  .about-panel {
    justify-content: center;
    align-items: flex-start;
  }

  .about-content {
    max-width: 36rem;
  }

  .about-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .about-name {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--color-deep);
    margin: 0;
  }

  .about-bio {
    font-family: var(--font-body);
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--color-deep);
    margin: 0;
  }

  .about-details p {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-stone);
    margin: 0;
  }

  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .about-link {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-deep);
    text-decoration: none;
    transition: all 0.2s var(--ease-smooth);
  }

  .about-link:hover {
    background: linear-gradient(135deg, var(--color-hot), var(--color-electric));
    color: white;
    border-color: transparent;
  }

  .about-footer {
    margin-top: 1rem;
  }

  .about-year {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-stone);
    letter-spacing: 0.05em;
  }

  /* Scroll hint */
  .scroll-hint {
    position: fixed;
    bottom: 2rem;
    right: 2.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-stone);
    transition: opacity 0.5s var(--ease-smooth);
    z-index: 50;
    animation: hintPulse 2s var(--ease-smooth) infinite;
  }

  .scroll-hint-text {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  @keyframes hintPulse {
    0%, 100% { opacity: 0.5; transform: translateX(0); }
    50% { opacity: 1; transform: translateX(4px); }
  }

  /* Mobile: keep horizontal scroll */
  @media (max-width: 768px) {
    .panel {
      padding: 5rem 1.5rem 2rem;
    }

    .panel-inner {
      gap: 1.5rem;
    }

    .cards-track {
      gap: 1rem;
    }

    .card {
      flex: 0 0 280px;
      min-height: 180px;
    }

    .thought-card {
      flex: 0 0 300px;
    }

    .adventure-card {
      flex: 0 0 300px;
      min-height: 260px;
    }

    .floating-nav {
      padding: 1rem 1.25rem;
    }

    .nav-dots {
      gap: 1rem;
    }

    .scroll-hint {
      bottom: 1rem;
      right: 1.5rem;
    }

    .panel-title {
      font-size: clamp(1.75rem, 8vw, 2.5rem);
    }
  }
</style>
