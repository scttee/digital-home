---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTripBySlug, getTripPhotos, getTripStats, getTrips } from '../../lib/photography-static';

export async function getStaticPaths() {
  const trips = getTrips();
  return trips.map(trip => ({
    params: { slug: trip.slug }
  }));
}

const { slug } = Astro.params;
const trip = getTripBySlug(slug);

if (!trip) {
  return Astro.redirect('/404');
}

const photos = getTripPhotos(trip.id);
const stats = getTripStats(trip.id);

function formatDate(dateString: string): string {
  return new Date(dateString).toLocaleDateString('en-AU', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}

// Atmospheric filler phrases
const vibes = [
  'Salt air and slow mornings',
  'No signal, no worries',
  'Golden hour lasts longer out here',
  'The kind of tired that feels good',
  'Sand in everything, care about nothing',
  'Stars you forgot existed',
  'The ocean does the thinking for you',
  'Time moves different by the water',
];

// Pick vibes based on photo count to fill the grid
function getVibesForGaps(photoCount: number): string[] {
  const cols = 3; // approximate grid columns
  const totalCells = Math.ceil((photoCount + 2) / cols) * cols; // round up to fill rows
  const gaps = totalCells - photoCount;
  return vibes.slice(0, Math.max(gaps, 1));
}

const fillerVibes = getVibesForGaps(photos.length);

// Interleave photos with vibe blocks
type GridItem = { type: 'photo'; data: typeof photos[0]; index: number } | { type: 'vibe'; text: string };
const gridItems: GridItem[] = [];
let vibeIndex = 0;

photos.forEach((photo, i) => {
  gridItems.push({ type: 'photo', data: photo, index: i });
  // Insert a vibe after every 3rd photo if we have vibes left
  if ((i + 1) % 3 === 0 && vibeIndex < fillerVibes.length) {
    gridItems.push({ type: 'vibe', text: fillerVibes[vibeIndex] });
    vibeIndex++;
  }
});

// Add remaining vibes at the end
while (vibeIndex < fillerVibes.length) {
  gridItems.push({ type: 'vibe', text: fillerVibes[vibeIndex] });
  vibeIndex++;
}
---

<BaseLayout title={`${trip.title} — Adventures`}>
  <div class="adventure-page">
    <!-- Hero -->
    {trip.cover_image_url && (
      <div class="hero">
        <img src={trip.cover_image_url} alt={trip.title} class="hero-img" />
        <div class="hero-overlay">
          <span class="hero-location">{trip.location}</span>
          <h1 class="hero-title">{trip.title}</h1>
          {trip.start_date && (
            <div class="hero-dates">
              <time>{formatDate(trip.start_date)}</time>
              {trip.end_date && <span> — {formatDate(trip.end_date)}</span>}
            </div>
          )}
        </div>
      </div>
    )}

    {!trip.cover_image_url && (
      <div class="info-header">
        <span class="hero-location">{trip.location}</span>
        <h1 class="hero-title">{trip.title}</h1>
        {trip.start_date && (
          <div class="hero-dates">
            <time>{formatDate(trip.start_date)}</time>
            {trip.end_date && <span> — {formatDate(trip.end_date)}</span>}
          </div>
        )}
      </div>
    )}

    {trip.description && (
      <div class="description-bar">
        <p>{trip.description}</p>
      </div>
    )}

    <!-- Photo grid — no borders, immersive -->
    <div class="photo-grid">
      {gridItems.map((item) =>
        item.type === 'photo' ? (
          <div class="grid-photo" style={`animation-delay: ${item.index * 0.06}s`}>
            <img src={item.data.file_url} alt={item.data.alt_text || item.data.caption || ''} loading="lazy" />
            {(item.data.caption_override || item.data.caption) && (
              <span class="grid-caption">{item.data.caption_override || item.data.caption}</span>
            )}
          </div>
        ) : (
          <div class="grid-vibe">
            <p class="vibe-text">{item.text}</p>
          </div>
        )
      )}
    </div>

    {photos.length === 0 && (
      <div class="empty-state">
        <p>No photos added to this adventure yet.</p>
      </div>
    )}

    <!-- Footer bar -->
    <div class="adventure-footer">
      {stats.cameras.length > 0 && (
        <div class="camera-info">
          <span class="camera-label">Shot with</span>
          {stats.cameras.map(cam => (
            <span class="camera-name">
              {cam.camera}
              {cam.count > 1 && <span class="camera-count"> x{cam.count}</span>}
            </span>
          ))}
        </div>
      )}
      <a href="/adventures" class="back-link">
        <span>&larr;</span>
        <span>Back to Adventures</span>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .adventure-page {
    margin: 0;
  }

  /* Hero — full bleed */
  .hero {
    position: relative;
    width: 100%;
    height: 70vh;
    overflow: hidden;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 4rem 2.5rem 2.5rem;
    background: linear-gradient(to top, rgba(28, 16, 23, 0.85) 0%, rgba(28, 16, 23, 0.4) 50%, transparent 100%);
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .hero-location {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-hot);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    color: white;
    margin: 0;
  }

  .hero-dates {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.7);
  }

  .info-header {
    padding: 3rem 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .description-bar {
    padding: 1.25rem 2.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .description-bar p {
    font-family: var(--font-body);
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-stone);
    margin: 0;
    max-width: 42rem;
  }

  /* Photo grid — no borders, edge to edge */
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 0;
  }

  .grid-photo {
    position: relative;
    overflow: hidden;
    min-height: 320px;
    animation: fadeIn 0.5s var(--ease-smooth) backwards;
  }

  .grid-photo img {
    width: 100%;
    height: 100%;
    min-height: 320px;
    object-fit: cover;
    transition: transform 0.4s var(--ease-smooth);
    display: block;
  }

  .grid-photo:hover img {
    transform: scale(1.03);
  }

  .grid-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 2.5rem 1.5rem 1.25rem;
    background: linear-gradient(to top, rgba(28, 16, 23, 0.7), transparent);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: white;
    opacity: 0;
    transition: opacity 0.3s var(--ease-smooth);
  }

  .grid-photo:hover .grid-caption {
    opacity: 1;
  }

  /* Vibe / quote blocks */
  .grid-vibe {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 320px;
    padding: 2.5rem;
    background: var(--color-deep);
    animation: fadeIn 0.5s var(--ease-smooth) backwards;
  }

  .vibe-text {
    font-family: var(--font-body);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-style: italic;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.6);
    text-align: center;
    margin: 0;
    max-width: 16rem;
  }

  /* Footer */
  .adventure-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 2.5rem;
    border-top: 1px solid var(--color-border);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .camera-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .camera-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-stone);
  }

  .camera-name {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-deep);
  }

  .camera-count {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-stone);
  }

  .back-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-stone);
    text-decoration: none;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--color-hot);
  }

  .empty-state {
    padding: 4rem 2.5rem;
    text-align: center;
  }

  .empty-state p {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-stone);
    margin: 0;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (max-width: 640px) {
    .photo-grid {
      grid-template-columns: 1fr;
    }

    .hero { height: 50vh; }

    .hero-overlay {
      padding: 3rem 1.5rem 1.5rem;
    }

    .description-bar {
      padding: 1rem 1.5rem;
    }

    .adventure-footer {
      padding: 1.25rem 1.5rem;
    }

    .grid-photo,
    .grid-photo img {
      min-height: 260px;
    }

    .grid-vibe {
      min-height: 200px;
    }
  }
</style>
