---
import '../../styles/global.css';
import { getTripBySlug, getTripPhotos, getTripStats, getTrips } from '../../lib/photography-static';

export async function getStaticPaths() {
  const trips = getTrips();
  return trips.map(trip => ({
    params: { slug: trip.slug }
  }));
}

const { slug } = Astro.params;
const trip = getTripBySlug(slug);

if (!trip) {
  return Astro.redirect('/404');
}

const photos = getTripPhotos(trip.id);
const stats = getTripStats(trip.id);

function formatDate(dateString: string): string {
  return new Date(dateString).toLocaleDateString('en-AU', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}

// Atmospheric story phrases
const vibes = [
  'Salt air and slow mornings',
  'No signal, no worries',
  'Golden hour lasts longer out here',
  'The kind of tired that feels good',
  'Sand in everything, care about nothing',
  'Stars you forgot existed',
  'The ocean does the thinking for you',
  'Time moves different by the water',
];

// Build horizontal story: photo panels interleaved with quote panels
type StoryPanel =
  | { type: 'photo'; photo: typeof photos[0]; layout: 'full' | 'centered' | 'split-left' | 'split-right' }
  | { type: 'pair'; left: typeof photos[0]; right: typeof photos[0] }
  | { type: 'quote'; text: string };

const panels: StoryPanel[] = [];
let vibeIdx = 0;

// Layout cycle for variety
const photoLayouts = ['full', 'split-left', 'full', 'centered', 'split-right'] as const;
let layoutIdx = 0;
let photoIdx = 0;

while (photoIdx < photos.length) {
  const layout = photoLayouts[layoutIdx % photoLayouts.length];

  // Try to pair photos at the 'centered' slot
  if (layout === 'centered' && photoIdx + 1 < photos.length) {
    panels.push({ type: 'pair', left: photos[photoIdx], right: photos[photoIdx + 1] });
    photoIdx += 2;
  } else {
    panels.push({ type: 'photo', photo: photos[photoIdx], layout: layout === 'centered' ? 'full' : layout });
    photoIdx++;
  }

  // Insert a quote panel between photo panels
  if (vibeIdx < vibes.length && photoIdx < photos.length) {
    panels.push({ type: 'quote', text: vibes[vibeIdx] });
    vibeIdx++;
  }

  layoutIdx++;
}

// Total panels: hero + description(optional) + story panels + closing panel
const totalDots = 1 + (trip.description ? 1 : 0) + panels.length + 1;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={trip.description || `${trip.title} — an adventure`}>
  <title>{trip.title} — Adventures</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body class="story-body">

  <!-- Fixed nav -->
  <nav class="story-nav">
    <a href="/adventures" class="nav-back" aria-label="Back to Adventures">&larr;</a>
    <a href="/" class="nav-logo">SS</a>
  </nav>

  <!-- Progress bar -->
  <div class="progress-track">
    <div class="progress-fill" id="progressFill"></div>
  </div>

  <!-- Horizontal scroll container -->
  <div class="scroller" id="scroller">

    <!-- Hero panel -->
    <section class="panel hero-panel">
      {trip.cover_image_url && (
        <img src={trip.cover_image_url} alt={trip.title} class="hero-bg" />
      )}
      <div class="hero-overlay">
        <span class="hero-location">{trip.location}</span>
        <h1 class="hero-title">{trip.title}</h1>
        {trip.start_date && (
          <div class="hero-dates">
            <time>{formatDate(trip.start_date)}</time>
            {trip.end_date && <span> — {formatDate(trip.end_date)}</span>}
          </div>
        )}
      </div>
      <div class="scroll-hint">
        <span class="hint-text">Swipe to explore</span>
        <span class="hint-arrow">→</span>
      </div>
    </section>

    <!-- Description panel (if exists) -->
    {trip.description && (
      <section class="panel text-panel">
        <div class="text-panel-inner">
          <p class="description-text">{trip.description}</p>
        </div>
      </section>
    )}

    <!-- Story panels -->
    {panels.map((panel) => {
      if (panel.type === 'quote') {
        return (
          <section class="panel quote-panel">
            <p class="quote-text">{panel.text}</p>
          </section>
        );
      }

      if (panel.type === 'pair') {
        return (
          <section class="panel pair-panel">
            <div class="pair-img">
              <img src={panel.left.file_url} alt={panel.left.alt_text || panel.left.caption || ''} />
              {(panel.left.caption_override || panel.left.caption) && (
                <span class="pair-caption">{panel.left.caption_override || panel.left.caption}</span>
              )}
            </div>
            <div class="pair-img">
              <img src={panel.right.file_url} alt={panel.right.alt_text || panel.right.caption || ''} />
              {(panel.right.caption_override || panel.right.caption) && (
                <span class="pair-caption">{panel.right.caption_override || panel.right.caption}</span>
              )}
            </div>
          </section>
        );
      }

      if (panel.layout === 'full') {
        return (
          <section class="panel photo-panel photo-full">
            <img src={panel.photo.file_url} alt={panel.photo.alt_text || panel.photo.caption || ''} class="photo-bg" />
            {(panel.photo.caption_override || panel.photo.caption) && (
              <span class="photo-caption-overlay">{panel.photo.caption_override || panel.photo.caption}</span>
            )}
          </section>
        );
      }

      if (panel.layout === 'split-left') {
        return (
          <section class="panel split-panel split-left">
            <div class="split-img">
              <img src={panel.photo.file_url} alt={panel.photo.alt_text || panel.photo.caption || ''} />
            </div>
            <div class="split-text">
              {(panel.photo.caption_override || panel.photo.caption) && (
                <p class="split-caption">{panel.photo.caption_override || panel.photo.caption}</p>
              )}
            </div>
          </section>
        );
      }

      if (panel.layout === 'split-right') {
        return (
          <section class="panel split-panel split-right">
            <div class="split-text">
              {(panel.photo.caption_override || panel.photo.caption) && (
                <p class="split-caption">{panel.photo.caption_override || panel.photo.caption}</p>
              )}
            </div>
            <div class="split-img">
              <img src={panel.photo.file_url} alt={panel.photo.alt_text || panel.photo.caption || ''} />
            </div>
          </section>
        );
      }

      // Fallback: centered
      return (
        <section class="panel photo-panel photo-centered">
          <div class="centered-wrap">
            <img src={panel.photo.file_url} alt={panel.photo.alt_text || panel.photo.caption || ''} />
          </div>
          {(panel.photo.caption_override || panel.photo.caption) && (
            <span class="photo-caption-overlay">{panel.photo.caption_override || panel.photo.caption}</span>
          )}
        </section>
      );
    })}

    <!-- Closing panel -->
    <section class="panel closing-panel">
      <div class="closing-inner">
        <p class="closing-vibe">{vibes[vibeIdx < vibes.length ? vibeIdx : vibes.length - 1]}</p>
        {stats.cameras.length > 0 && (
          <div class="closing-camera">
            <span class="cam-label">Shot with</span>
            {stats.cameras.map(cam => (
              <span class="cam-name">{cam.camera}</span>
            ))}
          </div>
        )}
        <a href="/adventures" class="closing-back">
          <span>&larr;</span>
          <span>All Adventures</span>
        </a>
      </div>
    </section>

  </div>

  <script>
    const scroller = document.getElementById('scroller');
    const progressFill = document.getElementById('progressFill');
    const hintEl = document.querySelector('.scroll-hint') as HTMLElement;

    if (scroller && progressFill) {
      scroller.addEventListener('scroll', () => {
        const maxScroll = scroller.scrollWidth - scroller.clientWidth;
        const progress = maxScroll > 0 ? scroller.scrollLeft / maxScroll : 0;
        progressFill.style.transform = `scaleX(${progress})`;

        // Fade out scroll hint
        if (hintEl) {
          const fade = Math.max(1 - (scroller.scrollLeft / (scroller.clientWidth * 0.3)), 0);
          hintEl.style.opacity = String(fade);
        }
      }, { passive: true });
    }

    // Reveal panels as they enter viewport
    const panels = document.querySelectorAll('.panel');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
        }
      });
    }, {
      root: scroller,
      threshold: 0.3
    });

    panels.forEach(p => observer.observe(p));

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (!scroller) return;
      const panelWidth = scroller.clientWidth;
      if (e.key === 'ArrowRight') {
        scroller.scrollBy({ left: panelWidth, behavior: 'smooth' });
      } else if (e.key === 'ArrowLeft') {
        scroller.scrollBy({ left: -panelWidth, behavior: 'smooth' });
      }
    });
  </script>

</body>
</html>

<style>
  /* ---- Base ---- */
  .story-body {
    margin: 0;
    padding: 0;
    overflow: hidden;
    height: 100vh;
    background: var(--color-deep);
  }

  /* ---- Fixed nav ---- */
  .story-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 2rem;
    z-index: 100;
    pointer-events: none;
  }

  .story-nav a {
    pointer-events: all;
  }

  .nav-back {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: white;
    text-decoration: none;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(28, 16, 23, 0.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: background 0.2s, color 0.2s;
  }

  .nav-back:hover {
    background: var(--color-hot);
    color: white;
  }

  .nav-logo {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: white;
    text-decoration: none;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(28, 16, 23, 0.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: background 0.2s, color 0.2s;
  }

  .nav-logo:hover {
    color: var(--color-hot);
  }

  /* ---- Progress bar ---- */
  .progress-track {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: rgba(255, 255, 255, 0.1);
    z-index: 100;
  }

  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--color-hot), var(--color-electric), var(--color-lime));
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 0.1s linear;
  }

  /* ---- Horizontal scroller ---- */
  .scroller {
    display: flex;
    height: 100vh;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .scroller::-webkit-scrollbar {
    display: none;
  }

  /* ---- Panel base ---- */
  .panel {
    flex: 0 0 100vw;
    width: 100vw;
    height: 100vh;
    scroll-snap-align: start;
    position: relative;
    overflow: hidden;
  }

  /* Reveal animation */
  .panel:not(.hero-panel) {
    opacity: 0;
    transition: opacity 0.6s var(--ease-smooth);
  }

  .panel.in-view {
    opacity: 1;
  }

  /* ---- Hero panel ---- */
  .hero-panel {
    display: flex;
    align-items: flex-end;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: relative;
    z-index: 2;
    padding: 4rem 3rem;
    width: 100%;
    background: linear-gradient(
      to top,
      rgba(28, 16, 23, 0.9) 0%,
      rgba(28, 16, 23, 0.4) 50%,
      transparent 100%
    );
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hero-location {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-hot);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.95;
    color: white;
    margin: 0;
  }

  .hero-dates {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.6);
  }

  .scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    right: 3rem;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
    transition: opacity 0.3s;
  }

  .hint-text {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .hint-arrow {
    font-size: 1.25rem;
    animation: slideRight 2s var(--ease-smooth) infinite;
  }

  @keyframes slideRight {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(6px); }
  }

  /* ---- Text / description panel ---- */
  .text-panel {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-offwhite);
  }

  .text-panel-inner {
    max-width: 32rem;
    padding: 3rem;
  }

  .description-text {
    font-family: var(--font-body);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    line-height: 1.6;
    color: var(--color-deep);
    margin: 0;
    text-align: center;
  }

  /* ---- Quote panel ---- */
  .quote-panel {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-deep);
    padding: 3rem;
  }

  .quote-text {
    font-family: var(--font-body);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1.2;
    color: rgba(255, 255, 255, 0.6);
    text-align: center;
    margin: 0;
    max-width: 20rem;
  }

  /* ---- Full bleed photo panel ---- */
  .photo-full {
    display: flex;
    align-items: flex-end;
  }

  .photo-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo-caption-overlay {
    position: relative;
    z-index: 2;
    display: block;
    padding: 2rem 3rem;
    width: 100%;
    background: linear-gradient(to top, rgba(28, 16, 23, 0.7), transparent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.8);
  }

  /* ---- Photo centered panel ---- */
  .photo-centered {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-deep);
  }

  .centered-wrap {
    width: 70%;
    max-height: 80vh;
    overflow: hidden;
  }

  .centered-wrap img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ---- Split panel (photo + text side by side) ---- */
  .split-panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .split-img {
    overflow: hidden;
  }

  .split-img img {
    width: 100%;
    height: 100vh;
    object-fit: cover;
    display: block;
  }

  .split-text {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem;
    background: var(--color-deep);
  }

  .split-caption {
    font-family: var(--font-body);
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    font-style: italic;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    max-width: 18rem;
  }

  /* ---- Pair panel (two photos stacked) ---- */
  .pair-panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    background: var(--color-deep);
  }

  .pair-img {
    position: relative;
    overflow: hidden;
  }

  .pair-img img {
    width: 100%;
    height: 100vh;
    object-fit: cover;
    display: block;
  }

  .pair-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 2rem 1.5rem 1rem;
    background: linear-gradient(to top, rgba(28, 16, 23, 0.6), transparent);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.8);
  }

  /* ---- Closing panel ---- */
  .closing-panel {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-offwhite);
  }

  .closing-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    text-align: center;
    padding: 3rem;
  }

  .closing-vibe {
    font-family: var(--font-body);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-style: italic;
    line-height: 1.3;
    color: var(--color-deep);
    margin: 0;
    max-width: 20rem;
    opacity: 0.6;
  }

  .closing-camera {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .cam-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-stone);
  }

  .cam-name {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-deep);
  }

  .closing-back {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-stone);
    text-decoration: none;
    padding: 0.75rem 1.5rem;
    border: 1.5px solid var(--color-border);
    border-radius: 2rem;
    transition: all 0.2s;
  }

  .closing-back:hover {
    color: var(--color-hot);
    border-color: var(--color-hot);
  }

  /* ---- Mobile ---- */
  @media (max-width: 768px) {
    .story-nav {
      padding: 1rem 1.25rem;
    }

    .nav-back,
    .nav-logo {
      width: 2.25rem;
      height: 2.25rem;
      font-size: 1rem;
    }

    .hero-overlay {
      padding: 3rem 1.5rem;
    }

    .scroll-hint {
      right: 1.5rem;
      bottom: 2rem;
    }

    .text-panel-inner {
      padding: 2rem 1.5rem;
    }

    .quote-panel {
      padding: 2rem;
    }

    /* Split becomes full photo on mobile */
    .split-panel {
      grid-template-columns: 1fr;
    }

    .split-text {
      display: none;
    }

    .split-img img {
      height: 100vh;
    }

    /* Pair becomes stacked vertically, each half height */
    .pair-panel {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr 1fr;
      gap: 2px;
    }

    .pair-img img {
      height: 50vh;
    }

    .closing-inner {
      padding: 2rem 1.5rem;
    }
  }
</style>
