---
import '../../styles/global.css';
import { getTripBySlug, getTripPhotos, getTripStats, getTrips } from '../../lib/photography-static';

export async function getStaticPaths() {
  const trips = getTrips();
  return trips.map(trip => ({
    params: { slug: trip.slug }
  }));
}

const { slug } = Astro.params;
const trip = getTripBySlug(slug);

if (!trip) {
  return Astro.redirect('/404');
}

const photos = getTripPhotos(trip.id);
const stats = getTripStats(trip.id);
const narrative = trip.narrative || [];

// Per-trip color scheme — each adventure feels different
const defaultColors = {
  accent: '#ff2d87',
  accentSoft: '#f9a8d4',
  text: '#fce7f3',
  textSoft: '#f9a8d4',
  bg: '#1c1017',
  gradientFrom: '#ff2d87',
  gradientTo: '#fb923c',
};
const colors = trip.colorScheme || defaultColors;

function formatDate(dateString: string): string {
  return new Date(dateString).toLocaleDateString('en-AU', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}

// Fallback vibes if no narrative
const defaultVibes = [
  'Salt air and slow mornings',
  'No signal, no worries',
  'Golden hour lasts longer out here',
  'The kind of tired that feels good',
];

const vibes = narrative.length > 0 ? narrative : defaultVibes;

// Layout presets for photo blocks
const photoPresets = [
  { w: 75, ph: 85, py: 'bottom', pw: 90, px: 'right' },
  { w: 50, ph: 55, py: 'top', pw: 80, px: 'left' },
  { w: 100, ph: 100, py: 'center', pw: 100, px: 'center' },
  { w: 60, ph: 70, py: 'top', pw: 85, px: 'right' },
  { w: 90, ph: 90, py: 'bottom', pw: 100, px: 'left' },
  { w: 45, ph: 50, py: 'center', pw: 70, px: 'center' },
  { w: 70, ph: 80, py: 'center', pw: 60, px: 'center' },
  { w: 55, ph: 65, py: 'bottom', pw: 85, px: 'left' },
];

// Text panel presets — these define how gallery-wall text blocks look
const textPresets = [
  { w: 55, py: 'center', px: 'center', size: 'large' },
  { w: 40, py: 'bottom', px: 'left', size: 'medium' },
  { w: 65, py: 'center', px: 'right', size: 'large' },
  { w: 45, py: 'top', px: 'center', size: 'medium' },
];

// Build the river: interleave photos with narrative text panels
type RiverItem =
  | { type: 'photo'; photo: typeof photos[0]; preset: typeof photoPresets[0]; caption: string | null }
  | { type: 'text'; text: string; preset: typeof textPresets[0] };

const river: RiverItem[] = [];
let vibeIdx = 0;
let photoIdx = 0;
let presetIdx = 0;
let textPresetIdx = 0;

// Pattern: photo, photo, TEXT, photo, photo, TEXT, ...
// Text panels appear every 2 photos
while (photoIdx < photos.length) {
  // Add a photo
  const photo = photos[photoIdx];
  river.push({
    type: 'photo',
    photo,
    preset: photoPresets[presetIdx % photoPresets.length],
    caption: (photo as any).caption_override || (photo as any).caption || null,
  });
  photoIdx++;
  presetIdx++;

  // After every 2nd photo, insert a narrative text panel
  if (photoIdx % 2 === 0 && vibeIdx < vibes.length) {
    river.push({
      type: 'text',
      text: vibes[vibeIdx],
      preset: textPresets[textPresetIdx % textPresets.length],
    });
    vibeIdx++;
    textPresetIdx++;
  }
}

// If we have remaining narrative, add them at the end
while (vibeIdx < vibes.length) {
  river.push({
    type: 'text',
    text: vibes[vibeIdx],
    preset: textPresets[textPresetIdx % textPresets.length],
  });
  vibeIdx++;
  textPresetIdx++;
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={trip.description || `${trip.title} — an adventure`}>
  <title>{trip.title} — Adventures</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body
  class="story-body"
  style={`--trip-accent: ${colors.accent}; --trip-accent-soft: ${colors.accentSoft}; --trip-text: ${colors.text}; --trip-text-soft: ${colors.textSoft}; --trip-bg: ${colors.bg}; --trip-grad-from: ${colors.gradientFrom}; --trip-grad-to: ${colors.gradientTo};`}
>

  <!-- Fixed nav -->
  <nav class="story-nav">
    <a href="/adventures" class="nav-back" aria-label="Back to Adventures">&larr;</a>
    <a href="/" class="nav-logo">SS</a>
  </nav>

  <!-- Progress bar -->
  <div class="progress-track">
    <div class="progress-fill" id="progressFill"></div>
  </div>

  <!-- Continuous horizontal scroll -->
  <div class="river" id="river">

    <!-- Hero block -->
    <div class="river-block hero-block">
      {trip.cover_image_url && (
        <img src={trip.cover_image_url} alt={trip.title} class="hero-bg" />
      )}
      <div class="hero-content">
        <span class="hero-location">{trip.location}</span>
        <h1 class="hero-title">{trip.title}</h1>
        {trip.start_date && (
          <div class="hero-dates">
            <time>{formatDate(trip.start_date)}</time>
            {trip.end_date && <span> — {formatDate(trip.end_date)}</span>}
          </div>
        )}
      </div>
      <div class="scroll-hint">
        <span class="hint-text">Scroll to explore</span>
        <span class="hint-arrow">→</span>
      </div>
    </div>

    <!-- Description as opening text panel -->
    {trip.description && (
      <div class="river-block text-block reveal" style="width: 50vw;" data-py="center" data-px="center" data-size="large">
        <p class="wall-text">{trip.description}</p>
      </div>
    )}

    <!-- River of photos + text -->
    {river.map((item) => {
      if (item.type === 'text') {
        return (
          <div
            class="river-block text-block reveal"
            style={`width: ${item.preset.w}vw;`}
            data-py={item.preset.py}
            data-px={item.preset.px}
            data-size={item.preset.size}
          >
            <p class="wall-text">{item.text}</p>
          </div>
        );
      }

      return (
        <div
          class="river-block photo-block reveal"
          style={`width: ${item.preset.w}vw;`}
          data-py={item.preset.py}
          data-px={item.preset.px}
        >
          <div
            class="photo-frame"
            style={`height: ${item.preset.ph}vh; width: ${item.preset.pw}%;`}
          >
            <img
              src={item.photo.file_url}
              alt={item.photo.alt_text || item.caption || ''}
              loading="lazy"
            />
          </div>

          {item.caption && (
            <span class="photo-caption">{item.caption}</span>
          )}
        </div>
      );
    })}

    {photos.length === 0 && (
      <div class="river-block text-block" style="width: 60vw;" data-py="center" data-px="center" data-size="large">
        <p class="wall-text wall-text-muted">No photos yet. This story is waiting to be told.</p>
      </div>
    )}

    <!-- Closing block -->
    <div class="river-block closing-block">
      <div class="closing-inner">
        {stats.cameras.length > 0 && (
          <div class="closing-camera">
            <span class="cam-label">Shot with</span>
            {stats.cameras.map(cam => (
              <span class="cam-name">{cam.camera}</span>
            ))}
          </div>
        )}
        <a href="/adventures" class="closing-back">
          <span>&larr;</span>
          <span>All Adventures</span>
        </a>
      </div>
    </div>

  </div>

  <script>
    const river = document.getElementById('river');
    const progressFill = document.getElementById('progressFill');
    const hintEl = document.querySelector('.scroll-hint') as HTMLElement;

    if (river && progressFill) {
      river.addEventListener('scroll', () => {
        const maxScroll = river.scrollWidth - river.clientWidth;
        const progress = maxScroll > 0 ? river.scrollLeft / maxScroll : 0;
        progressFill.style.transform = `scaleX(${progress})`;

        // Fade out scroll hint
        if (hintEl) {
          const fade = Math.max(1 - (river.scrollLeft / (river.clientWidth * 0.25)), 0);
          hintEl.style.opacity = String(fade);
        }
      }, { passive: true });
    }

    // Reveal blocks as they scroll into view
    const blocks = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, {
      root: river,
      threshold: 0.1,
      rootMargin: '0px 100px 0px 0px'
    });

    blocks.forEach(b => observer.observe(b));

    // Keyboard nav
    document.addEventListener('keydown', (e) => {
      if (!river) return;
      const step = window.innerWidth * 0.6;
      if (e.key === 'ArrowRight') {
        river.scrollBy({ left: step, behavior: 'smooth' });
      } else if (e.key === 'ArrowLeft') {
        river.scrollBy({ left: -step, behavior: 'smooth' });
      }
    });
  </script>

</body>
</html>

<style>
  /* ---- Base ---- */
  .story-body {
    margin: 0;
    padding: 0;
    overflow: hidden;
    height: 100vh;
    background: var(--trip-bg);
  }

  /* ---- Fixed nav ---- */
  .story-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 2rem;
    z-index: 100;
    pointer-events: none;
  }

  .story-nav a {
    pointer-events: all;
  }

  .nav-back {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--trip-text);
    text-decoration: none;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: background 0.2s, color 0.2s;
  }

  .nav-back:hover {
    background: var(--trip-accent);
    color: white;
  }

  .nav-logo {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--trip-text);
    text-decoration: none;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: background 0.2s, color 0.2s;
  }

  .nav-logo:hover {
    color: var(--trip-accent);
  }

  /* ---- Progress bar ---- */
  .progress-track {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: color-mix(in srgb, var(--trip-accent) 15%, transparent);
    z-index: 100;
  }

  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--trip-grad-from), var(--trip-grad-to));
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 0.15s linear;
  }

  /* ---- River: continuous horizontal scroll ---- */
  .river {
    display: flex;
    align-items: stretch;
    height: 100vh;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: 6vw;
    padding-right: 4vw;
  }

  .river::-webkit-scrollbar {
    display: none;
  }

  /* ---- Block base ---- */
  .river-block {
    flex-shrink: 0;
    height: 100vh;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  /* ---- Reveal ---- */
  .reveal {
    opacity: 0;
    transform: translateX(40px);
    transition: opacity 0.7s var(--ease-smooth), transform 0.7s var(--ease-smooth);
  }

  .reveal.visible {
    opacity: 1;
    transform: translateX(0);
  }

  /* ---- Hero ---- */
  .hero-block {
    width: 100vw;
    flex-shrink: 0;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding: 4rem 3rem;
    width: 100%;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--trip-bg) 95%, transparent) 0%,
      color-mix(in srgb, var(--trip-bg) 50%, transparent) 45%,
      transparent 100%
    );
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hero-location {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--trip-accent);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.95;
    color: var(--trip-text);
    margin: 0;
  }

  .hero-dates {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    color: var(--trip-text-soft);
  }

  .scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    right: 3rem;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--trip-text-soft);
    transition: opacity 0.3s;
  }

  .hint-text {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .hint-arrow {
    font-size: 1.25rem;
    animation: slideRight 2s var(--ease-smooth) infinite;
  }

  @keyframes slideRight {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(6px); }
  }

  /* ---- Photo blocks ---- */
  .photo-block {
    position: relative;
    padding: 2vh 0;
  }

  /* Vertical alignment */
  .photo-block[data-py="top"],
  .text-block[data-py="top"] {
    justify-content: flex-start;
  }

  .photo-block[data-py="center"],
  .text-block[data-py="center"] {
    justify-content: center;
  }

  .photo-block[data-py="bottom"],
  .text-block[data-py="bottom"] {
    justify-content: flex-end;
  }

  /* Horizontal alignment */
  .photo-block[data-px="left"],
  .text-block[data-px="left"] {
    align-items: flex-start;
  }

  .photo-block[data-px="center"],
  .text-block[data-px="center"] {
    align-items: center;
  }

  .photo-block[data-px="right"],
  .text-block[data-px="right"] {
    align-items: flex-end;
  }

  /* ---- Photo frame ---- */
  .photo-frame {
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
  }

  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s var(--ease-smooth);
  }

  .photo-frame:hover img {
    transform: scale(1.02);
  }

  /* ---- Photo caption ---- */
  .photo-caption {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--trip-accent-soft);
    opacity: 0.5;
    margin-top: 0.75rem;
  }

  /* ---- Gallery wall text panels ---- */
  .text-block {
    padding: 4vh 3vw;
  }

  .wall-text {
    font-family: var(--font-body);
    line-height: 1.25;
    color: var(--trip-text-soft);
    margin: 0;
    max-width: 30rem;
  }

  /* Large text — gallery wall statement */
  .text-block[data-size="large"] .wall-text {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--trip-text);
    max-width: 36rem;
  }

  /* Medium text — supporting narrative */
  .text-block[data-size="medium"] .wall-text {
    font-size: clamp(1.25rem, 2.5vw, 2rem);
    font-style: italic;
    line-height: 1.35;
    color: var(--trip-accent-soft);
    max-width: 24rem;
  }

  .wall-text-muted {
    opacity: 0.4;
    font-style: italic;
  }

  /* ---- Closing ---- */
  .closing-block {
    width: 40vw;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .closing-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    text-align: center;
  }

  .closing-camera {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .cam-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--trip-text-soft);
    opacity: 0.6;
  }

  .cam-name {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--trip-text-soft);
  }

  .closing-back {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--trip-text-soft);
    text-decoration: none;
    padding: 0.75rem 1.5rem;
    border: 1.5px solid var(--trip-accent-soft);
    border-radius: 2rem;
    opacity: 0.6;
    transition: all 0.2s;
  }

  .closing-back:hover {
    color: var(--trip-accent);
    border-color: var(--trip-accent);
    opacity: 1;
  }

  /* ---- Mobile ---- */
  @media (max-width: 768px) {
    .river {
      gap: 3vw;
    }

    .story-nav {
      padding: 0.75rem 1rem;
    }

    .nav-back,
    .nav-logo {
      width: 2rem;
      height: 2rem;
      font-size: 0.875rem;
    }

    .hero-content {
      padding: 2rem 1.25rem;
    }

    .hero-title {
      font-size: clamp(2rem, 10vw, 3.5rem);
    }

    .scroll-hint {
      right: 1.25rem;
      bottom: 1.5rem;
    }

    .hint-text {
      display: none;
    }

    /* Safe padding for all blocks — nav at top, progress bar at bottom */
    .river-block {
      padding-top: 4rem;
      padding-bottom: 1.5rem;
      box-sizing: border-box;
    }

    /* Force photo blocks to be wide on mobile */
    .photo-block {
      min-width: 92vw !important;
      width: 92vw !important;
    }

    /* Photo frames fill block but leave room for nav/chrome */
    .photo-frame {
      width: 100% !important;
      height: 65vh !important;
    }

    .photo-block[data-py="top"] .photo-frame,
    .photo-block[data-py="bottom"] .photo-frame {
      height: 60vh !important;
    }

    .photo-caption {
      font-size: 0.625rem;
    }

    /* Text blocks on mobile — generous safe padding */
    .text-block {
      min-width: 85vw !important;
      width: 85vw !important;
      padding: 5rem 6vw 3rem !important;
    }

    .text-block[data-size="large"] .wall-text {
      font-size: clamp(1.5rem, 7vw, 2.25rem);
    }

    .text-block[data-size="medium"] .wall-text {
      font-size: clamp(1.125rem, 5vw, 1.5rem);
    }

    /* Hero block doesn't need top padding — image covers it */
    .hero-block {
      padding-top: 0;
    }

    .closing-block {
      width: 85vw;
      min-width: 85vw;
    }
  }
</style>
