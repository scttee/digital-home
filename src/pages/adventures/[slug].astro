---
import '../../styles/global.css';
import { getTripBySlug, getTripPhotos, getTripStats, getTrips } from '../../lib/photography-static';

export async function getStaticPaths() {
  const trips = getTrips();
  return trips.map(trip => ({
    params: { slug: trip.slug }
  }));
}

const { slug } = Astro.params;
const trip = getTripBySlug(slug);

if (!trip) {
  return Astro.redirect('/404');
}

const photos = getTripPhotos(trip.id);
const stats = getTripStats(trip.id);

function formatDate(dateString: string): string {
  return new Date(dateString).toLocaleDateString('en-AU', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}

// Atmospheric phrases — placed alongside photos
const vibes = [
  'Salt air and slow mornings',
  'No signal, no worries',
  'Golden hour lasts longer out here',
  'The kind of tired that feels good',
  'Sand in everything, care about nothing',
  'Stars you forgot existed',
  'The ocean does the thinking for you',
  'Time moves different by the water',
];

// Layout presets for photo blocks — each defines size + position + optional quote placement
// w: width of the block in vw
// ph: photo height as % of viewport height
// py: photo vertical position (top, center, bottom)
// pw: photo width within block (% of block width)
// px: photo horizontal alignment (left, center, right)
// quote: where to place a quote relative to photo (above, below, left, right, overlay, none)
const layoutPresets = [
  { w: 75, ph: 85, py: 'bottom', pw: 90, px: 'right', quote: 'above' },
  { w: 50, ph: 55, py: 'top', pw: 80, px: 'left', quote: 'below' },
  { w: 100, ph: 100, py: 'center', pw: 100, px: 'center', quote: 'overlay' },
  { w: 45, ph: 50, py: 'center', pw: 70, px: 'center', quote: 'right' },
  { w: 60, ph: 70, py: 'top', pw: 85, px: 'right', quote: 'below' },
  { w: 90, ph: 90, py: 'bottom', pw: 100, px: 'left', quote: 'overlay' },
  { w: 40, ph: 45, py: 'bottom', pw: 75, px: 'left', quote: 'above' },
  { w: 70, ph: 80, py: 'center', pw: 60, px: 'center', quote: 'below' },
];

// Build story blocks
type StoryBlock = {
  photo: typeof photos[0];
  preset: typeof layoutPresets[0];
  vibe: string | null;
};

const storyBlocks: StoryBlock[] = photos.map((photo, i) => ({
  photo,
  preset: layoutPresets[i % layoutPresets.length],
  vibe: i < vibes.length ? vibes[i] : null,
}));
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={trip.description || `${trip.title} — an adventure`}>
  <title>{trip.title} — Adventures</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body class="story-body">

  <!-- Fixed nav -->
  <nav class="story-nav">
    <a href="/adventures" class="nav-back" aria-label="Back to Adventures">&larr;</a>
    <a href="/" class="nav-logo">SS</a>
  </nav>

  <!-- Progress bar -->
  <div class="progress-track">
    <div class="progress-fill" id="progressFill"></div>
  </div>

  <!-- Continuous horizontal scroll -->
  <div class="river" id="river">

    <!-- Hero block -->
    <div class="river-block hero-block">
      {trip.cover_image_url && (
        <img src={trip.cover_image_url} alt={trip.title} class="hero-bg" />
      )}
      <div class="hero-content">
        <span class="hero-location">{trip.location}</span>
        <h1 class="hero-title">{trip.title}</h1>
        {trip.start_date && (
          <div class="hero-dates">
            <time>{formatDate(trip.start_date)}</time>
            {trip.end_date && <span> — {formatDate(trip.end_date)}</span>}
          </div>
        )}
        {trip.description && (
          <p class="hero-desc">{trip.description}</p>
        )}
      </div>
      <div class="scroll-hint">
        <span class="hint-text">Scroll to explore</span>
        <span class="hint-arrow">→</span>
      </div>
    </div>

    <!-- Photo blocks -->
    {storyBlocks.map((block, i) => (
      <div
        class={`river-block photo-block reveal`}
        style={`width: ${block.preset.w}vw;`}
        data-py={block.preset.py}
        data-px={block.preset.px}
      >
        <div
          class={`photo-frame`}
          style={`height: ${block.preset.ph}vh; width: ${block.preset.pw}%;`}
        >
          <img
            src={block.photo.file_url}
            alt={block.photo.alt_text || block.photo.caption || ''}
            loading="lazy"
          />
          {block.preset.quote === 'overlay' && block.vibe && (
            <span class="vibe-overlay">{block.vibe}</span>
          )}
        </div>

        {block.vibe && block.preset.quote !== 'overlay' && (
          <p class={`vibe-text vibe-${block.preset.quote}`}>{block.vibe}</p>
        )}

        {(block.photo.caption_override || block.photo.caption) && block.preset.quote !== 'overlay' && (
          <span class="photo-caption">{block.photo.caption_override || block.photo.caption}</span>
        )}
      </div>
    ))}

    <!-- Closing block -->
    <div class="river-block closing-block">
      <div class="closing-inner">
        {stats.cameras.length > 0 && (
          <div class="closing-camera">
            <span class="cam-label">Shot with</span>
            {stats.cameras.map(cam => (
              <span class="cam-name">{cam.camera}</span>
            ))}
          </div>
        )}
        <a href="/adventures" class="closing-back">
          <span>&larr;</span>
          <span>All Adventures</span>
        </a>
      </div>
    </div>

  </div>

  <script>
    const river = document.getElementById('river');
    const progressFill = document.getElementById('progressFill');
    const hintEl = document.querySelector('.scroll-hint') as HTMLElement;

    if (river && progressFill) {
      river.addEventListener('scroll', () => {
        const maxScroll = river.scrollWidth - river.clientWidth;
        const progress = maxScroll > 0 ? river.scrollLeft / maxScroll : 0;
        progressFill.style.transform = `scaleX(${progress})`;

        // Fade out scroll hint
        if (hintEl) {
          const fade = Math.max(1 - (river.scrollLeft / (river.clientWidth * 0.25)), 0);
          hintEl.style.opacity = String(fade);
        }
      }, { passive: true });
    }

    // Reveal blocks as they scroll into view
    const blocks = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, {
      root: river,
      threshold: 0.1,
      rootMargin: '0px 100px 0px 0px'
    });

    blocks.forEach(b => observer.observe(b));

    // Keyboard nav
    document.addEventListener('keydown', (e) => {
      if (!river) return;
      const step = window.innerWidth * 0.6;
      if (e.key === 'ArrowRight') {
        river.scrollBy({ left: step, behavior: 'smooth' });
      } else if (e.key === 'ArrowLeft') {
        river.scrollBy({ left: -step, behavior: 'smooth' });
      }
    });
  </script>

</body>
</html>

<style>
  /* ---- Base ---- */
  .story-body {
    margin: 0;
    padding: 0;
    overflow: hidden;
    height: 100vh;
    background: var(--color-deep);
  }

  /* ---- Fixed nav ---- */
  .story-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 2rem;
    z-index: 100;
    pointer-events: none;
  }

  .story-nav a {
    pointer-events: all;
  }

  .nav-back {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: white;
    text-decoration: none;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(28, 16, 23, 0.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: background 0.2s, color 0.2s;
  }

  .nav-back:hover {
    background: var(--color-hot);
    color: white;
  }

  .nav-logo {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: white;
    text-decoration: none;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(28, 16, 23, 0.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: background 0.2s, color 0.2s;
  }

  .nav-logo:hover {
    color: var(--color-hot);
  }

  /* ---- Progress bar ---- */
  .progress-track {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: rgba(255, 255, 255, 0.08);
    z-index: 100;
  }

  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--color-hot), var(--color-electric), var(--color-lime));
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 0.15s linear;
  }

  /* ---- River: continuous horizontal scroll ---- */
  .river {
    display: flex;
    align-items: stretch;
    height: 100vh;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: 6vw;
    padding-right: 4vw;
  }

  .river::-webkit-scrollbar {
    display: none;
  }

  /* ---- Block base ---- */
  .river-block {
    flex-shrink: 0;
    height: 100vh;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  /* ---- Reveal ---- */
  .reveal {
    opacity: 0;
    transform: translateX(40px);
    transition: opacity 0.7s var(--ease-smooth), transform 0.7s var(--ease-smooth);
  }

  .reveal.visible {
    opacity: 1;
    transform: translateX(0);
  }

  /* ---- Hero ---- */
  .hero-block {
    width: 100vw;
    flex-shrink: 0;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding: 4rem 3rem;
    width: 100%;
    background: linear-gradient(
      to top,
      rgba(28, 16, 23, 0.92) 0%,
      rgba(28, 16, 23, 0.5) 45%,
      transparent 100%
    );
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hero-location {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-hot);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.95;
    color: white;
    margin: 0;
  }

  .hero-dates {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.6);
  }

  .hero-desc {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.5);
    margin: 0.5rem 0 0;
    max-width: 32rem;
  }

  .scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    right: 3rem;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
    transition: opacity 0.3s;
  }

  .hint-text {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .hint-arrow {
    font-size: 1.25rem;
    animation: slideRight 2s var(--ease-smooth) infinite;
  }

  @keyframes slideRight {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(6px); }
  }

  /* ---- Photo blocks ---- */
  .photo-block {
    position: relative;
    padding: 2vh 0;
  }

  /* Vertical alignment */
  .photo-block[data-py="top"] {
    justify-content: flex-start;
  }

  .photo-block[data-py="center"] {
    justify-content: center;
  }

  .photo-block[data-py="bottom"] {
    justify-content: flex-end;
  }

  /* Horizontal alignment of inner content */
  .photo-block[data-px="left"] {
    align-items: flex-start;
  }

  .photo-block[data-px="center"] {
    align-items: center;
  }

  .photo-block[data-px="right"] {
    align-items: flex-end;
  }

  /* ---- Photo frame ---- */
  .photo-frame {
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
  }

  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s var(--ease-smooth);
  }

  .photo-frame:hover img {
    transform: scale(1.02);
  }

  /* ---- Vibe / quote text ---- */
  .vibe-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 3rem 2.5rem 2rem;
    background: linear-gradient(to top, rgba(28, 16, 23, 0.75), transparent);
    font-family: var(--font-body);
    font-size: clamp(1.125rem, 2vw, 1.75rem);
    font-style: italic;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.85);
  }

  .vibe-text {
    font-family: var(--font-body);
    font-style: italic;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
    max-width: 16rem;
  }

  .vibe-above {
    font-size: clamp(1rem, 1.8vw, 1.375rem);
    margin-bottom: 1.5rem;
    order: -1;
  }

  .vibe-below {
    font-size: clamp(1rem, 1.8vw, 1.375rem);
    margin-top: 1.5rem;
  }

  .vibe-right {
    position: absolute;
    right: -12vw;
    top: 50%;
    transform: translateY(-50%);
    font-size: clamp(0.875rem, 1.5vw, 1.125rem);
    width: 10vw;
  }

  .vibe-left {
    position: absolute;
    left: -12vw;
    top: 50%;
    transform: translateY(-50%);
    font-size: clamp(0.875rem, 1.5vw, 1.125rem);
    width: 10vw;
  }

  /* ---- Photo caption ---- */
  .photo-caption {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.35);
    margin-top: 0.75rem;
  }

  /* ---- Closing ---- */
  .closing-block {
    width: 40vw;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .closing-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    text-align: center;
  }

  .closing-camera {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .cam-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.4);
  }

  .cam-name {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.6);
  }

  .closing-back {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    padding: 0.75rem 1.5rem;
    border: 1.5px solid rgba(255, 255, 255, 0.15);
    border-radius: 2rem;
    transition: all 0.2s;
  }

  .closing-back:hover {
    color: var(--color-hot);
    border-color: var(--color-hot);
  }

  /* ---- Mobile ---- */
  @media (max-width: 768px) {
    .river {
      gap: 4vw;
    }

    .story-nav {
      padding: 1rem 1.25rem;
    }

    .nav-back,
    .nav-logo {
      width: 2.25rem;
      height: 2.25rem;
      font-size: 1rem;
    }

    .hero-content {
      padding: 3rem 1.5rem;
    }

    .scroll-hint {
      right: 1.5rem;
      bottom: 2rem;
    }

    .photo-block {
      min-width: 75vw;
    }

    .vibe-right,
    .vibe-left {
      position: static;
      transform: none;
      width: auto;
    }

    .closing-block {
      width: 80vw;
    }
  }
</style>
