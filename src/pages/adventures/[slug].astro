---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoGallery from '../../components/PhotoGallery.svelte';
import { getTripBySlug, getTripPhotos, getTripStats, getTrips } from '../../lib/photography-static';

export async function getStaticPaths() {
  const trips = getTrips();
  return trips.map(trip => ({
    params: { slug: trip.slug }
  }));
}

const { slug } = Astro.params;
const trip = getTripBySlug(slug);

if (!trip) {
  return Astro.redirect('/404');
}

const photos = getTripPhotos(trip.id);
const stats = getTripStats(trip.id);

function formatDate(dateString: string): string {
  return new Date(dateString).toLocaleDateString('en-AU', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<BaseLayout title={`${trip.title} — Adventures`}>
  <div class="block-page">
    <div class="block-grid">
      <!-- Hero image block -->
      {trip.cover_image_url && (
        <div class="block hero-block">
          <img src={trip.cover_image_url} alt={trip.title} class="hero-img" />
        </div>
      )}

      <!-- Trip info block -->
      <div class="block info-block">
        <span class="block-label">{trip.location}</span>
        <h1 class="block-title">{trip.title}</h1>
        {trip.start_date && (
          <div class="trip-dates">
            <time>{formatDate(trip.start_date)}</time>
            {trip.end_date && (
              <span> — {formatDate(trip.end_date)}</span>
            )}
          </div>
        )}
        {trip.description && (
          <p class="trip-description">{trip.description}</p>
        )}
      </div>

      <!-- Stats blocks -->
      {stats.photoCount > 0 && (
        <div class="block stat-block">
          <span class="stat-number">{stats.photoCount}</span>
          <span class="stat-label">Photos</span>
        </div>
      )}

      {stats.cameras.length > 0 && (
        <div class="block stat-block">
          <span class="stat-label">Shot with</span>
          <div class="camera-list">
            {stats.cameras.map(cam => (
              <span class="camera-name">
                {cam.camera}
                {cam.count > 1 && <span class="camera-count"> x{cam.count}</span>}
              </span>
            ))}
          </div>
        </div>
      )}

      <!-- Photo blocks -->
      {photos.map((photo, i) => (
        <div class="block photo-block" style={`animation-delay: ${(i + 2) * 0.08}s`}>
          <img src={photo.file_url} alt={photo.alt_text || photo.caption || ''} class="photo-img" loading="lazy" />
          {(photo.caption_override || photo.caption) && (
            <span class="photo-caption">{photo.caption_override || photo.caption}</span>
          )}
        </div>
      ))}

      {photos.length === 0 && (
        <div class="block empty-block">
          <p>No photos added to this adventure yet.</p>
        </div>
      )}

      <!-- Back nav block -->
      <a href="/adventures" class="block nav-block">
        <span class="nav-arrow">&larr;</span>
        <span class="nav-text">Back to Adventures</span>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .block-page {
    padding: 0 1rem 4rem;
    max-width: 100%;
  }

  .block-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
  }

  .block {
    background: var(--color-offwhite);
    padding: 2rem;
    animation: blockIn 0.5s var(--ease-smooth) backwards;
    transition: background 0.2s var(--ease-smooth);
  }

  /* Hero block */
  .hero-block {
    grid-column: 1 / -1;
    padding: 0;
    max-height: 60vh;
    overflow: hidden;
  }

  .hero-img {
    width: 100%;
    height: 60vh;
    object-fit: cover;
  }

  /* Info block */
  .info-block {
    grid-column: 1 / -1;
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .block-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-hot);
  }

  .block-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .trip-dates {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.05em;
    color: var(--color-stone);
  }

  .trip-description {
    font-family: var(--font-body);
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-stone);
    max-width: 42rem;
    margin: 0.5rem 0 0;
  }

  /* Stat blocks */
  .stat-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 160px;
    text-align: center;
  }

  .stat-block:hover {
    background: var(--color-sand);
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 700;
    color: var(--color-hot);
    line-height: 1;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-stone);
    margin-top: 0.5rem;
  }

  .camera-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 0.5rem;
  }

  .camera-name {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-deep);
  }

  .camera-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-stone);
  }

  /* Photo blocks */
  .photo-block {
    padding: 0;
    position: relative;
    overflow: hidden;
    min-height: 280px;
  }

  .photo-block:hover {
    background: var(--color-offwhite);
  }

  .photo-img {
    width: 100%;
    height: 100%;
    min-height: 280px;
    object-fit: cover;
    transition: transform 0.4s var(--ease-smooth);
  }

  .photo-block:hover .photo-img {
    transform: scale(1.03);
  }

  .photo-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 2rem 1.5rem 1rem;
    background: linear-gradient(to top, rgba(28, 16, 23, 0.7), transparent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: white;
    opacity: 0;
    transition: opacity 0.3s var(--ease-smooth);
  }

  .photo-block:hover .photo-caption {
    opacity: 1;
  }

  /* Nav block */
  .nav-block {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 2rem;
    text-decoration: none;
    color: var(--color-stone);
    cursor: pointer;
  }

  .nav-block:hover {
    background: var(--color-sand);
    color: var(--color-hot);
  }

  .nav-arrow {
    font-size: 1.25rem;
    transition: transform 0.3s var(--ease-smooth);
  }

  .nav-block:hover .nav-arrow {
    transform: translateX(-4px);
  }

  .nav-text {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .empty-block {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 200px;
  }

  .empty-block p {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-stone);
    margin: 0;
  }

  @keyframes blockIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .block-grid {
      grid-template-columns: 1fr;
    }

    .info-block {
      padding: 2rem 1.5rem;
    }

    .hero-block,
    .hero-img {
      height: 40vh;
    }
  }
</style>
