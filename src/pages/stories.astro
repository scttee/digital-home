---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getStories } from '../lib/db-static';

const stories = getStories();

function formatDate(dateString: string): string {
  return new Date(dateString).toLocaleDateString('en-AU', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<BaseLayout title="Stories — Digital Home">
  <div class="block-page">
    <div class="block-grid">
      <!-- Header block -->
      <div class="block block-header">
        <span class="block-label">03 — Stories</span>
        <h1 class="block-title">Stories</h1>
        <p class="block-subtitle">Longer-form narratives. Visual essays. Multi-page explorations built like zines.</p>
      </div>

      <!-- Story blocks -->
      {stories.map((story, i) => (
        <a href={`/stories/${story.slug}`} class="block story-block" style={`animation-delay: ${i * 0.08}s`}>
          {story.cover_image_url && (
            <div class="story-image">
              <img src={story.cover_image_url} alt={story.title} loading="lazy" />
            </div>
          )}
          <div class="story-info">
            <h2 class="story-name">{story.title}</h2>
            {story.published_at && (
              <time class="story-date">{formatDate(story.published_at)}</time>
            )}
          </div>
          <span class="story-arrow">&rarr;</span>
        </a>
      ))}

      {stories.length === 0 && (
        <div class="block empty-block">
          <span class="empty-icon">&#9998;</span>
          <p>No stories published yet. Check back soon.</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .block-page {
    padding: 0 1rem 4rem;
    max-width: 100%;
  }

  .block-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
  }

  .block {
    background: var(--color-offwhite);
    padding: 2rem;
    animation: blockIn 0.5s var(--ease-smooth) backwards;
    transition: background 0.2s var(--ease-smooth);
  }

  .block:hover {
    background: var(--color-sand);
  }

  .block-header {
    grid-column: 1 / -1;
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .block-header:hover {
    background: var(--color-offwhite);
  }

  .block-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-hot);
  }

  .block-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .block-subtitle {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-stone);
    max-width: 36rem;
    margin: 0;
  }

  .story-block {
    display: flex;
    flex-direction: column;
    min-height: 300px;
    padding: 0;
    text-decoration: none;
    color: var(--color-deep);
    position: relative;
    overflow: hidden;
  }

  .story-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .story-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-smooth);
  }

  .story-block:hover .story-image img {
    transform: scale(1.05);
  }

  .story-info {
    padding: 1.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    flex: 1;
  }

  .story-name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .story-date {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    color: var(--color-stone);
  }

  .story-arrow {
    position: absolute;
    bottom: 1.5rem;
    right: 2rem;
    font-size: 1.25rem;
    color: var(--color-stone);
    transition: all 0.3s var(--ease-smooth);
  }

  .story-block:hover .story-arrow {
    color: var(--color-hot);
    transform: translateX(4px);
  }

  .empty-block {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 300px;
    gap: 1rem;
  }

  .empty-icon {
    font-size: 2rem;
    opacity: 0.3;
  }

  .empty-block p {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-stone);
    margin: 0;
  }

  @keyframes blockIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .block-grid {
      grid-template-columns: 1fr;
    }

    .block-header {
      padding: 2rem 1.5rem;
    }
  }
</style>
