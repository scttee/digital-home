---
import BaseLayout from '../layouts/BaseLayout.astro';
import Parser from 'rss-parser';

// ---- SUBSTACK CONFIG ----
// Update this URL to match your Substack publication
// Format: https://yourname.substack.com/feed
// If using a custom domain: https://yourdomain.com/feed
const SUBSTACK_FEED_URL = 'https://scttee.substack.com/feed';

// Fetch Substack posts at build time
interface SubstackPost {
  title: string;
  link: string;
  date: string;
  excerpt: string;
  image: string | null;
}

let substackPosts: SubstackPost[] = [];

try {
  const parser = new Parser({
    customFields: {
      item: ['content:encoded'],
    },
  });
  const feed = await parser.parseURL(SUBSTACK_FEED_URL);

  substackPosts = (feed.items || []).map(item => {
    // Extract first image from content for a thumbnail
    const content = (item as any)['content:encoded'] || item.content || '';
    const imgMatch = content.match(/<img[^>]+src="([^"]+)"/);
    const image = imgMatch ? imgMatch[1] : null;

    // Use description as excerpt, strip HTML
    const rawExcerpt = item.contentSnippet || item.content || '';
    const excerpt = rawExcerpt.replace(/<[^>]*>/g, '').slice(0, 200);

    return {
      title: item.title || 'Untitled',
      link: item.link || '#',
      date: item.pubDate || item.isoDate || '',
      excerpt: excerpt ? excerpt + (excerpt.length >= 200 ? '...' : '') : '',
      image,
    };
  });
} catch (e) {
  // Feed fetch failed — will show empty state
  console.warn('Could not fetch Substack feed:', (e as Error).message);
}

function formatDate(dateString: string): string {
  if (!dateString) return '';
  return new Date(dateString).toLocaleDateString('en-AU', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<BaseLayout title="Stories — Digital Home">
  <div class="block-page">
    <div class="block-grid">
      <!-- Header block -->
      <div class="block block-header">
        <span class="block-label">03 — Stories</span>
        <h1 class="block-title">Stories</h1>
        <p class="block-subtitle">Writing, thinking out loud, and longer-form pieces from my Substack.</p>
      </div>

      <!-- Substack posts -->
      {substackPosts.map((post, i) => (
        <a href={post.link} target="_blank" rel="noopener noreferrer" class="block story-block" style={`animation-delay: ${i * 0.08}s`}>
          {post.image && (
            <div class="story-image">
              <img src={post.image} alt={post.title} loading="lazy" />
            </div>
          )}
          <div class="story-info">
            <h2 class="story-name">{post.title}</h2>
            {post.excerpt && (
              <p class="story-excerpt">{post.excerpt}</p>
            )}
            {post.date && (
              <time class="story-date">{formatDate(post.date)}</time>
            )}
          </div>
          <span class="story-arrow">&nearr;</span>
        </a>
      ))}

      {substackPosts.length === 0 && (
        <div class="block empty-block">
          <span class="empty-icon">&#9998;</span>
          <p>No stories yet. Check back soon, or find me on <a href="https://substack.com/@scttee" target="_blank" rel="noopener noreferrer" class="substack-link">Substack</a>.</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .block-page {
    padding: 0 1rem 4rem;
    max-width: 100%;
  }

  .block-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
  }

  .block {
    background: var(--color-offwhite);
    padding: 2rem;
    animation: blockIn 0.5s var(--ease-smooth) backwards;
    transition: background 0.2s var(--ease-smooth);
  }

  .block:hover {
    background: var(--color-sand);
  }

  .block-header {
    grid-column: 1 / -1;
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .block-header:hover {
    background: var(--color-offwhite);
  }

  .block-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-hot);
  }

  .block-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .block-subtitle {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-stone);
    max-width: 36rem;
    margin: 0;
  }

  .story-block {
    display: flex;
    flex-direction: column;
    min-height: 300px;
    padding: 0;
    text-decoration: none;
    color: var(--color-deep);
    position: relative;
    overflow: hidden;
  }

  .story-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .story-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-smooth);
  }

  .story-block:hover .story-image img {
    transform: scale(1.05);
  }

  .story-info {
    padding: 1.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .story-name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .story-excerpt {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-stone);
    margin: 0;
  }

  .story-date {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    color: var(--color-stone);
  }

  .story-arrow {
    position: absolute;
    bottom: 1.5rem;
    right: 2rem;
    font-size: 1.25rem;
    color: var(--color-stone);
    transition: all 0.3s var(--ease-smooth);
  }

  .story-block:hover .story-arrow {
    color: var(--color-hot);
    transform: translate(2px, -2px);
  }

  .empty-block {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 300px;
    gap: 1rem;
  }

  .empty-icon {
    font-size: 2rem;
    opacity: 0.3;
  }

  .empty-block p {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-stone);
    margin: 0;
  }

  .substack-link {
    color: var(--color-hot);
    text-decoration: none;
    border-bottom: 1px solid var(--color-hot);
  }

  .substack-link:hover {
    opacity: 0.8;
  }

  @keyframes blockIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .block-grid {
      grid-template-columns: 1fr;
    }

    .block-header {
      padding: 2rem 1.5rem;
    }
  }
</style>
