---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSubstackPosts } from '../lib/substack';

const substackPosts = await getSubstackPosts();

function formatDate(dateString: string): string {
  if (!dateString) return '';
  return new Date(dateString).toLocaleDateString('en-AU', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}

const featured = substackPosts[0] || null;
const rest = substackPosts.slice(1);
---

<BaseLayout title="Stories — Digital Home">
  <div class="stories-page">
    <div class="stories-header">
      <span class="stories-label">03 — Stories</span>
      <h1 class="stories-title">Stories</h1>
      <p class="stories-sub">Writing, thinking out loud, and longer-form pieces from <a href="https://substack.com/@scttee" target="_blank" rel="noopener noreferrer" class="substack-link">Substack</a>.</p>
    </div>

    {featured && (
      <a href={featured.link} target="_blank" rel="noopener noreferrer" class="featured-story">
        {featured.image && (
          <div class="featured-image">
            <img src={featured.image} alt={featured.title} loading="lazy" />
          </div>
        )}
        <div class="featured-info">
          <span class="featured-badge">Latest</span>
          <h2 class="featured-title">{featured.title}</h2>
          {featured.excerpt && (
            <p class="featured-excerpt">{featured.excerpt}</p>
          )}
          {featured.date && (
            <time class="featured-date">{formatDate(featured.date)}</time>
          )}
          <span class="featured-cta">Read on Substack &nearr;</span>
        </div>
      </a>
    )}

    {rest.length > 0 && (
      <div class="stories-list">
        {rest.map((post, i) => (
          <a href={post.link} target="_blank" rel="noopener noreferrer" class="story-row" style={`animation-delay: ${i * 0.06}s`}>
            <div class="story-row-info">
              <h3 class="story-row-title">{post.title}</h3>
              {post.excerpt && (
                <p class="story-row-excerpt">{post.excerpt}</p>
              )}
            </div>
            <div class="story-row-meta">
              {post.date && (
                <time class="story-row-date">{formatDate(post.date)}</time>
              )}
              <span class="story-row-arrow">&nearr;</span>
            </div>
          </a>
        ))}
      </div>
    )}

    {substackPosts.length === 0 && (
      <div class="stories-empty">
        <p>Stories live on Substack. Check back soon, or find me at <a href="https://substack.com/@scttee" target="_blank" rel="noopener noreferrer" class="substack-link">substack.com/@scttee</a>.</p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .stories-page {
    padding: 0 2rem 6rem;
    max-width: 56rem;
    margin: 0 auto;
  }

  .stories-header {
    padding: 3rem 0 4rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stories-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-lime);
  }

  .stories-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.95;
    background: linear-gradient(135deg, var(--color-lime), var(--color-electric));
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradShift 5s ease infinite;
  }

  .stories-sub {
    font-family: var(--font-body);
    font-size: 1.125rem;
    color: var(--color-stone);
    margin: 0;
  }

  .substack-link {
    color: var(--color-lime);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    transition: opacity 0.2s;
  }

  .substack-link:hover {
    opacity: 0.7;
  }

  @keyframes gradShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  /* ---- Featured story — hero card ---- */
  .featured-story {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--color-deep);
    margin-bottom: 4rem;
    overflow: hidden;
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--color-lime) 5%, var(--color-offwhite));
    transition: all 0.3s var(--ease-smooth);
  }

  .featured-story:hover {
    transform: translateY(-3px);
    background: color-mix(in srgb, var(--color-lime) 10%, var(--color-offwhite));
  }

  .featured-image {
    width: 100%;
    height: 320px;
    overflow: hidden;
  }

  .featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-smooth);
  }

  .featured-story:hover .featured-image img {
    transform: scale(1.03);
  }

  .featured-info {
    padding: 2rem 2.5rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .featured-badge {
    display: inline-block;
    width: fit-content;
    padding: 0.2rem 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-lime);
    background: color-mix(in srgb, var(--color-lime) 12%, transparent);
    border-radius: 2rem;
  }

  .featured-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0;
  }

  .featured-excerpt {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-stone);
    margin: 0;
  }

  .featured-date {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    color: var(--color-stone);
  }

  .featured-cta {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-lime);
    transition: color 0.2s;
  }

  .featured-story:hover .featured-cta {
    color: var(--color-electric);
  }

  /* ---- Story list ---- */
  .stories-list {
    display: flex;
    flex-direction: column;
  }

  .story-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    padding: 2rem 0;
    text-decoration: none;
    color: var(--color-deep);
    border-bottom: 1px solid var(--color-border);
    transition: border-color 0.3s;
    animation: rowIn 0.4s var(--ease-smooth) backwards;
  }

  .story-row:last-child {
    border-bottom: none;
  }

  .story-row:hover {
    border-color: var(--color-lime);
  }

  .story-row-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .story-row-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0;
    transition: color 0.2s;
  }

  .story-row:hover .story-row-title {
    color: var(--color-lime);
  }

  .story-row-excerpt {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-stone);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .story-row-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .story-row-date {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    color: var(--color-stone);
    white-space: nowrap;
  }

  .story-row-arrow {
    font-size: 1.125rem;
    color: var(--color-stone);
    transition: all 0.2s;
  }

  .story-row:hover .story-row-arrow {
    color: var(--color-lime);
    transform: translate(2px, -2px);
  }

  @keyframes rowIn {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ---- Empty state ---- */
  .stories-empty {
    text-align: center;
    padding: 6rem 0;
  }

  .stories-empty p {
    font-family: var(--font-body);
    font-size: 1.125rem;
    color: var(--color-stone);
    margin: 0;
  }

  @media (max-width: 640px) {
    .stories-page {
      padding: 0 1.25rem 4rem;
    }

    .stories-header {
      padding: 2rem 0 3rem;
    }

    .featured-image {
      height: 200px;
    }

    .featured-info {
      padding: 1.5rem;
    }

    .story-row {
      flex-direction: column;
      gap: 0.75rem;
    }

    .story-row-meta {
      order: -1;
    }
  }
</style>
