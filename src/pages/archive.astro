---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllMedia, getCollections } from '../lib/db-static';

const media = getAllMedia();
const collections = getCollections();

// Give photos varied spans for visual interest
const spanPattern = [false, false, true, false, false, false, true, false] as const;
---

<BaseLayout title="Archive — Digital Home">
  <div class="archive-page">
    <div class="archive-header">
      <span class="archive-label">Visual Archive</span>
      <h1 class="archive-title">Archive</h1>
      <p class="archive-sub">Moments captured. A living wall of images, organized by intention not algorithm.</p>
    </div>

    {collections.length > 0 && (
      <div class="collections-row">
        {collections.map((collection, i) => (
          <a href={`/archive/${collection.slug}`} class="collection-chip" style={`animation-delay: ${i * 0.08}s`}>
            <span class="chip-label">Collection</span>
            <span class="chip-name">{collection.title}</span>
            <span class="chip-arrow">&rarr;</span>
          </a>
        ))}
      </div>
    )}

    <div class="photo-wall">
      {media.map((item, i) => {
        const isWide = spanPattern[i % spanPattern.length];
        return (
          <div class={`wall-item ${isWide ? 'wall-wide' : ''}`} style={`animation-delay: ${i * 0.04}s`}>
            <img src={item.file_url} alt={item.alt_text || item.caption || ''} loading="lazy" />
            {item.caption && (
              <div class="wall-caption">
                <span>{item.caption}</span>
              </div>
            )}
          </div>
        );
      })}

      {media.length === 0 && collections.length === 0 && (
        <div class="archive-empty">
          <p>No media yet. The archive is waiting.</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .archive-page {
    padding: 0 2rem 6rem;
    max-width: 80rem;
    margin: 0 auto;
  }

  .archive-header {
    padding: 3rem 0 3rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .archive-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-sunset);
  }

  .archive-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.95;
    background: linear-gradient(135deg, var(--color-sunset), var(--color-hot));
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradShift 5s ease infinite;
  }

  .archive-sub {
    font-family: var(--font-body);
    font-size: 1.125rem;
    color: var(--color-stone);
    margin: 0;
  }

  @keyframes gradShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  /* ---- Collection chips ---- */
  .collections-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 3rem;
  }

  .collection-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    background: color-mix(in srgb, var(--color-sunset) 8%, transparent);
    border-radius: 2rem;
    text-decoration: none;
    color: var(--color-deep);
    transition: all 0.2s var(--ease-smooth);
    animation: chipIn 0.4s var(--ease-smooth) backwards;
  }

  .collection-chip:hover {
    background: color-mix(in srgb, var(--color-sunset) 18%, transparent);
    transform: translateY(-1px);
  }

  .chip-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-sunset);
  }

  .chip-name {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .chip-arrow {
    color: var(--color-stone);
    transition: transform 0.2s;
  }

  .collection-chip:hover .chip-arrow {
    transform: translateX(3px);
    color: var(--color-sunset);
  }

  @keyframes chipIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ---- Photo wall — masonry-ish grid ---- */
  .photo-wall {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }

  .wall-item {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1;
    animation: wallIn 0.5s var(--ease-smooth) backwards;
    cursor: default;
  }

  /* Every few images span 2 columns for variety */
  .wall-wide {
    grid-column: span 2;
    aspect-ratio: 2/1;
  }

  .wall-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s var(--ease-smooth);
  }

  .wall-item:hover img {
    transform: scale(1.04);
  }

  .wall-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 2.5rem 1.25rem 1rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.65), transparent);
    opacity: 0;
    transition: opacity 0.35s var(--ease-smooth);
  }

  .wall-item:hover .wall-caption {
    opacity: 1;
  }

  .wall-caption span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: white;
  }

  .archive-empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 4rem 0;
  }

  .archive-empty p {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-stone);
    margin: 0;
  }

  @keyframes wallIn {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (max-width: 768px) {
    .archive-page {
      padding: 0 1rem 4rem;
    }

    .photo-wall {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.25rem;
    }

    .wall-wide {
      grid-column: span 2;
    }

    .archive-header {
      padding: 2rem 0.25rem 2rem;
    }
  }

  @media (max-width: 480px) {
    .photo-wall {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
