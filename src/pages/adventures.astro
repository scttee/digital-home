---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTrips } from '../lib/photography-static';

const trips = getTrips();

function formatDate(dateString: string): string {
  return new Date(dateString).toLocaleDateString('en-AU', {
    year: 'numeric',
    month: 'short'
  });
}
---

<BaseLayout title="Adventures — Digital Home">
  <div class="block-page">
    <div class="block-grid">
      <!-- Header block -->
      <div class="block block-header">
        <span class="block-label">02 — Adventures</span>
        <h1 class="block-title">Adventures</h1>
        <p class="block-subtitle">Photographic journeys. Places explored, moments captured, stories told through images.</p>
      </div>

      <!-- Trip blocks -->
      {trips.map((trip, i) => (
        <a href={`/adventures/${trip.slug}`} class="block trip-block" style={`animation-delay: ${i * 0.08}s`}>
          {trip.cover_image_url && (
            <div class="trip-image">
              <img src={trip.cover_image_url} alt={trip.title} loading="lazy" />
            </div>
          )}
          <div class="trip-info">
            <span class="trip-location">{trip.location}</span>
            <h2 class="trip-name">{trip.title}</h2>
            {trip.description && <p class="trip-description">{trip.description}</p>}
            {trip.start_date && (
              <time class="trip-date">{formatDate(trip.start_date)}</time>
            )}
          </div>
          <span class="trip-arrow">&rarr;</span>
        </a>
      ))}

      {trips.length === 0 && (
        <div class="block empty-block">
          <p>No adventures documented yet. Start exploring.</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .block-page {
    padding: 0 1rem 4rem;
    max-width: 100%;
  }

  .block-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
  }

  .block {
    background: var(--color-offwhite);
    padding: 2rem;
    animation: blockIn 0.5s var(--ease-smooth) backwards;
    transition: background 0.2s var(--ease-smooth);
  }

  .block:hover {
    background: var(--color-sand);
  }

  .block-header {
    grid-column: 1 / -1;
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .block-header:hover {
    background: var(--color-offwhite);
  }

  .block-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-hot);
  }

  .block-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .block-subtitle {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-stone);
    max-width: 36rem;
    margin: 0;
  }

  .trip-block {
    display: flex;
    flex-direction: column;
    min-height: 340px;
    padding: 0;
    text-decoration: none;
    color: var(--color-deep);
    position: relative;
    overflow: hidden;
  }

  .trip-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .trip-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-smooth);
  }

  .trip-block:hover .trip-image img {
    transform: scale(1.05);
  }

  .trip-info {
    padding: 1.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    flex: 1;
  }

  .trip-location {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-hot);
  }

  .trip-name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .trip-description {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-stone);
    margin: 0;
  }

  .trip-date {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    color: var(--color-stone);
    margin-top: auto;
  }

  .trip-arrow {
    position: absolute;
    bottom: 1.5rem;
    right: 2rem;
    font-size: 1.25rem;
    color: var(--color-stone);
    transition: all 0.3s var(--ease-smooth);
  }

  .trip-block:hover .trip-arrow {
    color: var(--color-hot);
    transform: translateX(4px);
  }

  .empty-block {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 200px;
  }

  .empty-block p {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-stone);
    margin: 0;
  }

  @keyframes blockIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .block-grid {
      grid-template-columns: 1fr;
    }

    .block-header {
      padding: 2rem 1.5rem;
    }
  }
</style>
