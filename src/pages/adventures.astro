---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTrips } from '../lib/photography-static';

const trips = getTrips();

function formatDate(dateString: string): string {
  return new Date(dateString).toLocaleDateString('en-AU', {
    year: 'numeric',
    month: 'short'
  });
}

// Predefined positions for floating cards (in % from center)
const floatPositions = [
  { x: -32, y: -28, r: -3, delay: 0 },
  { x: 28, y: -22, r: 2, delay: 0.1 },
  { x: -25, y: 22, r: -2, delay: 0.2 },
  { x: 30, y: 26, r: 3, delay: 0.3 },
  { x: -38, y: 2, r: -1, delay: 0.15 },
  { x: 36, y: -2, r: 1.5, delay: 0.25 },
  { x: 0, y: -35, r: -2, delay: 0.05 },
  { x: 0, y: 35, r: 1, delay: 0.35 },
];
---

<BaseLayout title="Adventures — Digital Home">
  <div class="adventures-space">
    <!-- Central title -->
    <div class="center-title">
      <span class="center-label">02</span>
      <h1 class="center-heading">
        <span class="gradient-text">Adventures</span>
      </h1>
      <p class="center-sub">Select an adventure</p>
    </div>

    <!-- Floating trip cards -->
    {trips.map((trip, i) => {
      const pos = floatPositions[i % floatPositions.length];
      return (
        <a
          href={`/adventures/${trip.slug}`}
          class="float-card"
          style={`--fx: ${pos.x}%; --fy: ${pos.y}%; --fr: ${pos.r}deg; --delay: ${pos.delay}s;`}
        >
          {trip.cover_image_url && (
            <div class="float-card-img">
              <img src={trip.cover_image_url} alt={trip.title} loading="lazy" />
            </div>
          )}
          <div class="float-card-info">
            <span class="float-card-location">{trip.location}</span>
            <h2 class="float-card-name">{trip.title}</h2>
            {trip.start_date && (
              <time class="float-card-date">{formatDate(trip.start_date)}</time>
            )}
          </div>
        </a>
      );
    })}

    {trips.length === 0 && (
      <div class="empty-state">
        <p>No adventures documented yet.</p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .adventures-space {
    position: relative;
    min-height: calc(100vh - 7rem);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    overflow: hidden;
  }

  /* Central title */
  .center-title {
    text-align: center;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .center-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: var(--color-hot);
    text-transform: uppercase;
  }

  .center-heading {
    font-family: var(--font-display);
    font-size: clamp(4rem, 12vw, 8rem);
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 0.85;
    margin: 0;
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--color-hot), var(--color-electric), var(--color-lime));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .center-sub {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-stone);
    margin: 0;
  }

  /* Floating cards */
  .float-card {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(calc(-50% + var(--fx)), calc(-50% + var(--fy))) rotate(var(--fr));
    width: clamp(200px, 22vw, 280px);
    background: var(--color-offwhite);
    border: 1px solid var(--color-border);
    text-decoration: none;
    color: var(--color-deep);
    overflow: hidden;
    z-index: 2;
    transition: all 0.35s var(--ease-smooth);
    animation: floatIn 0.6s var(--ease-smooth) var(--delay) backwards;
  }

  .float-card:hover {
    transform: translate(calc(-50% + var(--fx)), calc(-50% + var(--fy))) rotate(0deg) scale(1.08);
    border-color: var(--color-hot);
    z-index: 10;
    color: var(--color-deep);
  }

  .float-card-img {
    width: 100%;
    height: 140px;
    overflow: hidden;
  }

  .float-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-smooth);
  }

  .float-card:hover .float-card-img img {
    transform: scale(1.06);
  }

  .float-card-info {
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .float-card-location {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-hot);
  }

  .float-card-name {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0;
  }

  .float-card-date {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.05em;
    color: var(--color-stone);
  }

  .empty-state {
    position: absolute;
    top: 60%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .empty-state p {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-stone);
    margin: 0;
  }

  @keyframes floatIn {
    from {
      opacity: 0;
      transform: translate(calc(-50% + var(--fx)), calc(-50% + var(--fy))) rotate(var(--fr)) scale(0.8);
    }
    to {
      opacity: 1;
      transform: translate(calc(-50% + var(--fx)), calc(-50% + var(--fy))) rotate(var(--fr)) scale(1);
    }
  }

  /* Mobile: stack cards below title */
  @media (max-width: 768px) {
    .adventures-space {
      flex-direction: column;
      gap: 2rem;
      padding: 2rem 1.25rem 4rem;
      min-height: auto;
    }

    .center-heading {
      font-size: clamp(3rem, 15vw, 5rem);
    }

    .float-card {
      position: relative;
      top: auto;
      left: auto;
      transform: rotate(var(--fr));
      width: 100%;
      max-width: 360px;
      animation: floatInMobile 0.5s var(--ease-smooth) var(--delay) backwards;
    }

    .float-card:hover {
      transform: rotate(0deg) scale(1.02);
    }
  }

  @keyframes floatInMobile {
    from {
      opacity: 0;
      transform: rotate(var(--fr)) translateY(20px);
    }
    to {
      opacity: 1;
      transform: rotate(var(--fr));
    }
  }
</style>
