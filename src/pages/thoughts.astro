---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getThoughts } from '../lib/db-static';

const thoughts = getThoughts(50);

function formatDate(dateString: string): string {
  return new Date(dateString).toLocaleDateString('en-AU', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  });
}

function parseTags(tags: string | null): string[] {
  if (!tags) return [];
  try { return JSON.parse(tags); } catch { return []; }
}

// Alternate between featured (big) and regular (small) thoughts
const sizes = ['big', 'regular', 'regular', 'big', 'regular'] as const;
---

<BaseLayout title="Thoughts — Digital Home">
  <div class="thoughts-page">
    <div class="thoughts-header">
      <span class="thoughts-label">01 — Thoughts</span>
      <h1 class="thoughts-title">Thoughts</h1>
      <p class="thoughts-sub">A running stream. No algorithms, just chronology.</p>
    </div>

    <div class="thoughts-stream">
      {thoughts.map((thought, i) => {
        const size = sizes[i % sizes.length];
        return (
          <div class={`thought ${size === 'big' ? 'thought-big' : 'thought-regular'}`} style={`animation-delay: ${i * 0.06}s`}>
            <p class="thought-text">{thought.content}</p>
            <div class="thought-footer">
              {parseTags(thought.tags).length > 0 && (
                <div class="thought-tags">
                  {parseTags(thought.tags).map((tag) => (
                    <span class="thought-tag">{tag}</span>
                  ))}
                </div>
              )}
              <time class="thought-date">{formatDate(thought.created_at)}</time>
            </div>
          </div>
        );
      })}

      {thoughts.length === 0 && (
        <div class="thought thought-empty">
          <p class="thought-text">No thoughts yet. The stream is waiting.</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .thoughts-page {
    padding: 0 2rem 6rem;
    max-width: 64rem;
    margin: 0 auto;
  }

  .thoughts-header {
    padding: 3rem 0 4rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .thoughts-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-hot);
  }

  .thoughts-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.95;
    background: linear-gradient(135deg, var(--color-hot), var(--color-electric));
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradShift 5s ease infinite;
  }

  .thoughts-sub {
    font-family: var(--font-body);
    font-size: 1.125rem;
    color: var(--color-stone);
    margin: 0;
  }

  @keyframes gradShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  /* ---- Stream layout ---- */
  .thoughts-stream {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .thought {
    animation: thoughtIn 0.5s var(--ease-smooth) backwards;
    padding: 2rem 0;
    border-bottom: 1px solid var(--color-border);
    transition: border-color 0.3s;
  }

  .thought:hover {
    border-color: var(--color-hot);
  }

  .thought:last-child {
    border-bottom: none;
  }

  /* Big thoughts — statement-sized */
  .thought-big .thought-text {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: var(--color-deep);
    margin: 0 0 1.5rem;
  }

  /* Regular thoughts — body copy */
  .thought-regular .thought-text {
    font-family: var(--font-body);
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-deep);
    margin: 0 0 1.25rem;
    max-width: 40rem;
  }

  .thought-footer {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .thought-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .thought-tag {
    display: inline-block;
    padding: 0.2rem 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    color: var(--color-electric);
    background: color-mix(in srgb, var(--color-electric) 10%, transparent);
    border-radius: 2rem;
  }

  .thought-date {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    color: var(--color-stone);
  }

  .thought-empty {
    text-align: center;
    padding: 4rem 0;
  }

  .thought-empty .thought-text {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-stone);
  }

  @keyframes thoughtIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .thoughts-page {
      padding: 0 1.25rem 4rem;
    }

    .thoughts-header {
      padding: 2rem 0 3rem;
    }

    .thought-big .thought-text {
      font-size: clamp(1.5rem, 6vw, 2rem);
    }

    .thought {
      padding: 1.5rem 0;
    }
  }
</style>
