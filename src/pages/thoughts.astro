---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getThoughts } from '../lib/db-static';

const thoughts = getThoughts(50);

function formatDate(dateString: string): string {
  return new Date(dateString).toLocaleDateString('en-AU', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  });
}

function parseTags(tags: string | null): string[] {
  if (!tags) return [];
  try { return JSON.parse(tags); } catch { return []; }
}
---

<BaseLayout title="Thoughts — Digital Home">
  <div class="block-page">
    <div class="block-grid">
      <!-- Header block -->
      <div class="block block-header">
        <span class="block-label">01 — Thoughts</span>
        <h1 class="block-title">Thoughts</h1>
        <p class="block-subtitle">A running stream of ideas, observations, and micro-reflections. No algorithms, just chronology.</p>
      </div>

      <!-- Thought blocks -->
      {thoughts.map((thought, i) => (
        <div class="block thought-block" style={`animation-delay: ${i * 0.06}s`}>
          <p class="thought-content">{thought.content}</p>
          <div class="thought-footer">
            {parseTags(thought.tags).length > 0 && (
              <div class="thought-tags">
                {parseTags(thought.tags).map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
            <time class="thought-date">{formatDate(thought.created_at)}</time>
          </div>
        </div>
      ))}

      {thoughts.length === 0 && (
        <div class="block empty-block">
          <p>No thoughts yet.</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .block-page {
    padding: 0 1rem 4rem;
    max-width: 100%;
  }

  .block-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
  }

  .block {
    background: var(--color-offwhite);
    padding: 2rem;
    animation: blockIn 0.5s var(--ease-smooth) backwards;
    transition: background 0.2s var(--ease-smooth);
  }

  .block:hover {
    background: var(--color-sand);
  }

  .block-header {
    grid-column: 1 / -1;
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .block-header:hover {
    background: var(--color-offwhite);
  }

  .block-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-hot);
  }

  .block-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .block-subtitle {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-stone);
    max-width: 36rem;
    margin: 0;
  }

  .thought-block {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 200px;
    cursor: default;
  }

  .thought-content {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-deep);
    margin: 0 0 1.5rem;
    flex: 1;
  }

  .thought-footer {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .thought-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .tag {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    background: var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    color: var(--color-stone);
    border-radius: 4px;
  }

  .thought-date {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    color: var(--color-stone);
  }

  .empty-block {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 200px;
  }

  .empty-block p {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-stone);
    margin: 0;
  }

  @keyframes blockIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .block-grid {
      grid-template-columns: 1fr;
    }

    .block-header {
      padding: 2rem 1.5rem;
    }
  }
</style>
